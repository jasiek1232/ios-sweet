+		fsr = *(volatile uint32_t *)(v + 0x58);
+		far = *(volatile uint32_t *)(v + 0x60) | ((uint64_t)*(volatile uint32_t *)(v + 0x64) << 32);
+		fsy = *(volatile uint32_t *)(v + 0x68);
