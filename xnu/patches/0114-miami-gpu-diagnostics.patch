+		st = *(volatile uint32_t *)v;
+	if ((v = g_gpu_map(G_CP_BASE + 0x201 * 4)))
+		i0 = *(volatile uint32_t *)v;
+	if ((v = g_gpu_map(G_CP_BASE + 0x821 * 4)))
+		hf = *(volatile uint32_t *)v;
+	if (svc.rptr_va)
