+/*
+ * ---- v2 clients: the NativeAdreno ABI that Turnip's darwin backend speaks (iokit/Kernel/arm/SweetGPUService.cpp) ----
+ *
+ * Every connection gets its own 2 GiB window of GPU addresses and picks the addresses inside it itself, so
+ * mappings can be made and unmade one buffer at a time (the v1 service above only ever adds).
+ *
+ * Buffers that the CPU maps write-combined come from a pool of RAM XNU does not manage. This kernel has no PPL, so
+ * the physical map holds every managed page with a cacheable mapping that cannot be changed: any other view of a
+ * managed page is a mismatched alias and CPU writes through it get lost (found the hard way by ios-flame). The pool
+ * is 512 MiB of the upper DRAM bank that the ADT's dram-size leaves out (tools/mkadt.py exposes 3 GiB of the 4 GiB
+ * at 0x180000000). Its base is a boot-arg: sweetgpupool=0x250000000 (default).
+ */
+#define G_WIN_BASE	0x1000000000ull		/* 64 GiB */
+#define G_WIN_SIZE	0x80000000ull		/* 2 GiB per connection */
+#define G_WIN_LIMIT	0x7e00000000ull		/* below the highest address the boot probes got translated */
+#define G_WIN_MAX	((unsigned)((G_WIN_LIMIT - G_WIN_BASE) / G_WIN_SIZE))
+
+static uint8_t g_win_used[G_WIN_MAX];
+
+int sweet_gpu_window_alloc(uint64_t *base, uint64_t *size);
+void sweet_gpu_window_free(uint64_t base);
+int sweet_gpu_map_at(uint64_t iova, const uint64_t *pages, uint32_t npages, int noncached);
+void sweet_gpu_unmap_at(uint64_t iova, uint64_t len);
+uint32_t sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bool *busy);
+int sweet_gpu_wait_fence_ns(uint32_t fence, uint64_t timeout_ns);
+bool sweet_gpu_lost(uint64_t *epoch, uint32_t last_fence);
+uint64_t sweet_gpu_timestamp(void);
+int sweet_gpu_pool_alloc(uint64_t bytes, uint64_t *pa);
+void sweet_gpu_pool_free(uint64_t pa, uint64_t bytes);
+int sweet_gpu_boot_mode(void);
+
+int
+sweet_gpu_boot_mode(void)
+{
+	return g_boot_mode;
+}
+
+int
+sweet_gpu_window_alloc(uint64_t *base, uint64_t *size)
+{
+	int rc = -1;
+	lck_mtx_lock(&g_svc_lock);
+	if (svc.ready && g_user_end >= G_WIN_LIMIT) {
+		for (unsigned i = 0; i < G_WIN_MAX; i++) {
+			if (!g_win_used[i]) {
+				g_win_used[i] = 1;
+				*base = G_WIN_BASE + (uint64_t)i * G_WIN_SIZE;
+				*size = G_WIN_SIZE;
+				rc = 0;
+				break;
+			}
+		}
+	}
+	lck_mtx_unlock(&g_svc_lock);
+	return rc;
+}
+
+void
+sweet_gpu_window_free(uint64_t base)
+{
+	if (base < G_WIN_BASE || base >= G_WIN_LIMIT)
+		return;
+	lck_mtx_lock(&g_svc_lock);
+	g_win_used[(base - G_WIN_BASE) / G_WIN_SIZE] = 0;
+	lck_mtx_unlock(&g_svc_lock);
+}
+
+/* The next-level table of an entry, or NULL when there is none (nothing is created) */
+static volatile uint64_t *
+g_as_peek(volatile uint64_t *tbl, unsigned idx)
+{
+	if (!(tbl[idx] & 1ull))
+		return NULL;
+	uint64_t pa = tbl[idx] & 0x0000fffffffff000ull;
+	return (volatile uint64_t *)(gp.pt_kva + (vm_offset_t)(pa - gp.pt_pa));
+}
+
+/* Map 4 KiB pages at iova. noncached: the CPU maps the pages write-combined (pool memory), so the GPU must not cache them. */
+int
+sweet_gpu_map_at(uint64_t iova, const uint64_t *pages, uint32_t npages, int noncached)
+{
+	const uint64_t pte = noncached ? G_PTE_PAGE_NC : G_PTE_PAGE_WB;
+	int rc = 0;
+	if (!svc.ready || (iova & 0xfffull))
+		return -1;
+	lck_mtx_lock(&g_svc_lock);
+	for (uint32_t i = 0; i < npages; i++) {
+		if (!g_as_map(iova + (uint64_t)i * 0x1000u, pages[i], 0x1000u, pte)) {
+			rc = -1;
+			break;
+		}
+	}
+	g_as_sync();
+	g_tlb_flush();
+	lck_mtx_unlock(&g_svc_lock);
+	return rc;
+}
+
+/* Unmap [iova, iova + len): the table pages stay, the entries are cleared. The caller has waited for the GPU. */
+void
+sweet_gpu_unmap_at(uint64_t iova, uint64_t len)
+{
+	volatile uint64_t *l1 = (volatile uint64_t *)gp.pt_kva;
+	lck_mtx_lock(&g_svc_lock);
+	for (uint64_t off = 0; off < len; off += 0x1000u) {
+		uint64_t v = iova + off;
+		volatile uint64_t *l2 = g_as_peek(l1, (unsigned)((v >> 30) & 0x1ff));
+		volatile uint64_t *l3 = l2 ? g_as_peek(l2, (unsigned)((v >> 21) & 0x1ff)) : NULL;
+		if (l3)
+			l3[(v >> 12) & 0x1ff] = 0;
+	}
+	g_as_sync();
+	g_tlb_flush();
+	lck_mtx_unlock(&g_svc_lock);
+}
+
+/* Several indirect buffers in one fenced submission. Returns the fence, or 0 (busy: the ring stayed full). */
+__attribute__((optnone, noinline)) uint32_t
+sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bool *busy)
+{
+	uint32_t cmds[4 * 16];
+	uint32_t seq = 0;
+	*busy = false;
+	if (n == 0 || n > 16)
+		return 0;
+	for (unsigned i = 0; i < n; i++) {
+		cmds[i * 4 + 0] = G_PKT7(0x3f, 3);
+		cmds[i * 4 + 1] = (uint32_t)iova[i];
+		cmds[i * 4 + 2] = (uint32_t)(iova[i] >> 32);
+		cmds[i * 4 + 3] = dwords[i];
+	}
+	int rc = sweet_gpu_submit(cmds, n * 4, &seq);
+	if (rc == -2)
+		*busy = true;
+	return rc == 0 ? seq : 0;
+}
+
+/*
+ * Wait for a fence, ns = 0 polls once. A wait of a second or more that saw no progress at all while work is queued
+ * is a hang or an SMMU fault: reset the GPU (everything in flight is lost) and report a timeout.
+ */
+__attribute__((optnone, noinline)) int
+sweet_gpu_wait_fence_ns(uint32_t fence, uint64_t timeout_ns)
+{
+	volatile uint32_t *f = (volatile uint32_t *)gp.fence.kva;
+	unsigned ms = (unsigned)(timeout_ns / 1000000ull) + (timeout_ns % 1000000ull ? 1u : 0u);
+	flush_dcache64((addr64_t)gp.fence.pa, 0x1000, TRUE);
+	uint32_t before = *f;
+	if (sweet_gpu_wait(fence, ms) == 0)
+		return 0;
+	flush_dcache64((addr64_t)gp.fence.pa, 0x1000, TRUE);
+	if (ms >= 1000 && *f == before && (int32_t)(svc.seq - before) > 0) {
+		vm_offset_t cb = g_gpu_map(0x05948000ull);
+		if (cb) {
+			printf("SWEET GPUQ: no progress for %u ms, fence %u of %u: smmu fsr 0x%x far 0x%llx\n", ms, before, svc.seq,
+			    *(volatile uint32_t *)(cb + 0x58),
+			    (unsigned long long)(*(volatile uint32_t *)(cb + 0x60) | ((uint64_t)*(volatile uint32_t *)(cb + 0x64) << 32)));
+		}
+		(void)g_gpu_recover();
+	}
+	return -1;
+}
+
+/* true once, for a client that has not yet seen the latest reset */
+bool
+sweet_gpu_lost(uint64_t *epoch, uint32_t last_fence)
+{
+	(void)last_fence;
+	if (*epoch == g_epoch)
+		return false;
+	*epoch = g_epoch;
+	return true;
+}
+
+/* CP_ALWAYS_ON_COUNTER (19.2 MHz) */
+uint64_t
+sweet_gpu_timestamp(void)
+{
+	vm_offset_t lo = g_gpu_map(G_CP_BASE + 0x980 * 4), hi = g_gpu_map(G_CP_BASE + 0x981 * 4);
+	if (!lo || !hi)
+		return 0;
+	uint32_t h1, l, h2;
+	do {
+		h1 = *(volatile uint32_t *)hi;
+		l = *(volatile uint32_t *)lo;
+		h2 = *(volatile uint32_t *)hi;
+	} while (h1 != h2);
+	return ((uint64_t)h1 << 32) | l;
+}
+
+/* the pool: 16 KiB pages of unmanaged RAM, one byte each */
+#define G_POOL_SIZE	0x20000000ull
+#define G_POOL_PAGE	0x4000ull
+static uint64_t g_pool_base = 0x250000000ull;
+static uint8_t g_pool_used[G_POOL_SIZE / G_POOL_PAGE];
+static LCK_MTX_DECLARE(g_pool_lock, &g_svc_grp);
+
+int
+sweet_gpu_pool_alloc(uint64_t bytes, uint64_t *pa)
+{
+	const unsigned total = (unsigned)(G_POOL_SIZE / G_POOL_PAGE);
+	const unsigned need = (unsigned)((bytes + G_POOL_PAGE - 1) / G_POOL_PAGE);
+	int rc = -1;
+	if (need == 0 || need > total)
+		return -1;
+	lck_mtx_lock(&g_pool_lock);
+	for (unsigned i = 0, run = 0; i < total; i++) {
+		run = g_pool_used[i] ? 0 : run + 1;
+		if (run == need) {
+			unsigned first = i + 1 - need;
+			for (unsigned j = first; j <= i; j++)
+				g_pool_used[j] = 1;
+			*pa = g_pool_base + (uint64_t)first * G_POOL_PAGE;
+			rc = 0;
+			break;
+		}
+	}
+	lck_mtx_unlock(&g_pool_lock);
+	return rc;
+}
+
+void
+sweet_gpu_pool_free(uint64_t pa, uint64_t bytes)
+{
+	if (pa < g_pool_base || pa >= g_pool_base + G_POOL_SIZE)
+		return;
+	lck_mtx_lock(&g_pool_lock);
+	unsigned first = (unsigned)((pa - g_pool_base) / G_POOL_PAGE);
+	unsigned need = (unsigned)((bytes + G_POOL_PAGE - 1) / G_POOL_PAGE);
+	for (unsigned j = first; j < first + need && j < G_POOL_SIZE / G_POOL_PAGE; j++)
+		g_pool_used[j] = 0;
+	lck_mtx_unlock(&g_pool_lock);
+}
+
