+	case NativeAdrenoMethodSetMetadata:
+		return kIOReturnSuccess;        /* only for dma-buf exports, which Darwin has not */
+	case NativeAdrenoMethodGetMetadata: {
+		V2_OUT(NativeAdrenoAbiMetadata);
+		return kIOReturnSuccess;        /* bytes 0 */
+	}
+	case NativeAdrenoMethodCreateQueue: {
+		V2_OUT(NativeAdrenoAbiQueueReply);
+		rp->queue = 1;                  /* one ring: every queue is queue 0 */
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodCloseQueue:
+		return kIOReturnSuccess;
+	default:
+		return kIOReturnUnsupported;
+	}
+#undef V2_IN
+#undef V2_OUT
+}
+
+/*
+ * sweetgpu=5: in-kernel exercise of the v2 client, the part of the ABI that decides whether Turnip can work:
+ * pool memory that the CPU writes write-combined and the GPU reads and writes non-cacheable, with no cache
+ * maintenance anywhere. 64 rounds: the CPU writes a fresh command stream (write-combined), the GPU runs it
+ * and writes a word, the CPU reads the word back. A lost or stale write shows up as a wrong count.
+ */
+static IOReturn
+sweet_v2_call(SweetGPUUserClient *c, uint32_t method, const void *in, uint32_t isz, void *out, uint32_t osz)
+{
+	IOExternalMethodArguments a;
+	bzero(&a, sizeof(a));
+	a.structureInput = in;
+	a.structureInputSize = isz;
+	a.structureOutput = out;
+	a.structureOutputSize = osz;
+	return c->externalMethod(method, &a, NULL, NULL, NULL);
+}
+
+static void
+sweet_gpu_v2_selftest(void)
+{
+	SweetGPUUserClient *c = OSTypeAlloc(SweetGPUUserClient);
+	if (c == NULL || !c->initWithTask(kernel_task, NULL, SWEET_V2_OPEN_TYPE)) {
+		IOLog("SWEET GPUV: could not create a v2 client (no GPU window?)\n");
+		OSSafeReleaseNULL(c);
+		return;
+	}
+	if (!c->attach(gSweetGPUService) || !c->start(gSweetGPUService)) {
+		IOLog("SWEET GPUV: v2 client attach/start failed\n");
+		c->release();
+		return;
+	}
+	IOReturn r;
+	NativeAdrenoAbiParams qp;
+	NativeAdrenoAbiDeviceInfo di;
+	r = sweet_v2_call(c, NativeAdrenoMethodQuery, NULL, 0, &qp, sizeof(qp));
+	IOLog("SWEET GPUV: query -> 0x%x abi %u in %u out %u max bo 0x%llx\n", r, qp.abi_version, qp.input_bits, qp.output_bits, qp.max_bo_bytes);
+	r = sweet_v2_call(c, NativeAdrenoMethodGetDeviceInfo, NULL, 0, &di, sizeof(di));
+	IOLog("SWEET GPUV: device info -> 0x%x chip 0x%x gmem 0x%x window 0x%llx + 0x%llx\n", r, di.chip_id, di.gmem_bytes, di.va_start, di.va_size);
+
+	NativeAdrenoAbiBoAlloc al = { 0x40000, 12, 0 };
+	NativeAdrenoAbiBoAllocReply ar;
+	r = sweet_v2_call(c, NativeAdrenoMethodBoAlloc, &al, sizeof(al), &ar, sizeof(ar));
+	IOLog("SWEET GPUV: alloc 0x40000 from the pool -> 0x%x handle %llu\n", r, ar.handle);
+	if (r != kIOReturnSuccess) {
+		c->clientClose();
+		c->release();
+		return;
+	}
+	NativeAdrenoAbiBoCpuMap cm = { ar.handle };
+	NativeAdrenoAbiBoCpuMapReply cr;
+	r = sweet_v2_call(c, NativeAdrenoMethodBoCpuMap, &cm, sizeof(cm), &cr, sizeof(cr));
+	IOOptionBits opts = 0;
+	IOMemoryDescriptor *md = NULL;
+	IOMemoryMap *map = NULL;
+	if (r == kIOReturnSuccess && c->clientMemoryForType(cr.token, &opts, &md) == kIOReturnSuccess && md != NULL) {
+		map = md->map(opts);
+	}
+	const uint64_t iova = di.va_start + 0x10000;
+	NativeAdrenoAbiBoMap bm = { ar.handle, iova, 3, 0, 3, 0 };
+	NativeAdrenoAbiBoMapReply br;
+	IOReturn mr = sweet_v2_call(c, NativeAdrenoMethodBoMap, &bm, sizeof(bm), &br, sizeof(br));
+	IOLog("SWEET GPUV: cpu map token %u -> %s, gpu map at 0x%llx -> 0x%x\n", cr.token, map ? "ok" : "FAILED", iova, mr);
+	if (map != NULL && mr == kIOReturnSuccess) {
+		volatile uint32_t *p = (volatile uint32_t *)map->getVirtualAddress();
+		unsigned good = 0, rounds = 64;
+		uint32_t fence = 0;
+		for (unsigned i = 0; i < rounds; i++) {
+			const uint64_t target = iova + 0x1000 + i * 4;
+			const uint32_t want = 0x5ca10000u + i;
+			p[0x1000 / 4 + i] = 0;
+			p[0] = 0x703d8003u;             /* CP_MEM_WRITE, 3 dwords */
+			p[1] = (uint32_t)target;
+			p[2] = (uint32_t)(target >> 32);
+			p[3] = want;
+			__asm__ volatile ("dsb sy" ::: "memory");
+			NativeAdrenoAbiSubmit sb;
+			bzero(&sb, sizeof(sb));
+			sb.buffer_count = 1;
+			sb.buffers[0].handle = ar.handle;
+			sb.buffers[0].iova = iova;
+			sb.buffers[0].bytes = 16;
+			NativeAdrenoAbiSubmitReply sr;
+			r = sweet_v2_call(c, NativeAdrenoMethodSubmit, &sb, sizeof(sb), &sr, sizeof(sr));
+			if (r != kIOReturnSuccess) {
+				IOLog("SWEET GPUV: submit %u -> 0x%x\n", i, r);
+				break;
+			}
+			NativeAdrenoAbiWaitFence wf = { sr.fence, 500000000ULL };
+			r = sweet_v2_call(c, NativeAdrenoMethodWaitFence, &wf, sizeof(wf), NULL, 0);
+			fence = (uint32_t)sr.fence;
+			if (r == kIOReturnSuccess && p[0x1000 / 4 + i] == want) {
+				good++;
+			}
+		}
+		IOLog("SWEET GPUV: %u of %u rounds correct (last fence %u) -> %s\n", good, rounds, fence,
+		    good == rounds ? "V2 CLIENT WORKS (write-combined CPU, non-cacheable GPU, coherent)" : "MISMATCH");
+		NativeAdrenoAbiTimestamp t1, t2;
+		(void)sweet_v2_call(c, NativeAdrenoMethodGetTimestamp, NULL, 0, &t1, sizeof(t1));
+		IOSleep(10);
+		(void)sweet_v2_call(c, NativeAdrenoMethodGetTimestamp, NULL, 0, &t2, sizeof(t2));
+		IOLog("SWEET GPUV: GPU counter %llu -> %llu after 10 ms\n", t1.ticks, t2.ticks);
+		/* an IB outside the client's window must be refused, not run */
+		NativeAdrenoAbiSubmit bad;
+		bzero(&bad, sizeof(bad));
+		bad.buffer_count = 1;
+		bad.buffers[0].iova = di.va_start + di.va_size;
+		bad.buffers[0].bytes = 16;
+		NativeAdrenoAbiSubmitReply sr2;
+		r = sweet_v2_call(c, NativeAdrenoMethodSubmit, &bad, sizeof(bad), &sr2, sizeof(sr2));
+		IOLog("SWEET GPUV: submit outside the window -> 0x%x (%s)\n", r, r == kIOReturnBadArgument ? "refused, as it must" : "WRONG");
+	}
+	if (map != NULL) {
+		map->release();
+	}
+	if (md != NULL) {
+		md->release();
+	}
+	NativeAdrenoAbiBoFree fr = { ar.handle };
+	r = sweet_v2_call(c, NativeAdrenoMethodBoFree, &fr, sizeof(fr), NULL, 0);
+	IOLog("SWEET GPUV: free -> 0x%x\n", r);
+	c->clientClose();
+	c->release();
+	IOLog("SWEET GPUV: v2 selftest done\n");
+}
+
 /*
  * In-kernel exercise of the user client, called from the GPU thread when the boot-arg is sweetgpu=4 or more:
  * it opens a client on the service like a process would, and drives selectors 0, 1, 5, 4, 5 and 2 with a
@@ -419,5 +1026,8 @@ sweet_gpu_service_selftest(void)
 	client->clientClose();
 	client->release();
 	IOLog("SWEET GPUT: selftest done\n");
+	if (sweet_gpu_boot_mode() >= 5) {
+		sweet_gpu_v2_selftest();
+	}
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
