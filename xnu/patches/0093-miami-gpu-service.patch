+/*
+ * The Adreno 619 as an IOKit service. Boot-arg sweetgpu=1/2 brings the GPU up (bsd/dev/sweet_gpu_a619.c);
+ * with it SweetGPUService is published, and a userland process can open a user client on it
+ * (IOServiceMatching("SweetGPUService"), IOServiceOpen type 0).
+ *
+ * Deliberately not an IOAcceleratorES: iOS frameworks (backboardd, Metal) go looking for that class and would
+ * start trying to use a GPU renderer that does not exist yet. A later step can publish the accelerator alias.
+ *
+ * Structure and selectors follow ios-flame's SweetAccelerator (MIT, same author line as ios-sweet).
+ *
+ * User client, scalar in/out:
+ *   0 info            -> [gpu_id, chip_id, ready]
+ *   1 buffer alloc    [size] -> [handle, gpu_va, size]  zeroed, wired, cleaned; map it into the task
+ *                     with IOConnectMapMemory64(type = handle): cacheable, so userland does the cache
+ *                     maintenance (the GPU does not snoop)
+ *   2 buffer free     [handle]                          (the GPU VA is not reused yet)
+ *   3 surface import  [IOSurface id] -> [handle, gpu_va, size]  the surface's pages, wired
+ *   4 submit          [ib_gpu_va, dwords, timeout_ms] -> [fence]  runs the IB and waits for it
+ *   5 cache flush     [handle, offset, length]  clean+invalidate through the kernel mapping: before
+ *                     a submit for what the CPU wrote, after it for what the CPU will read
+ * Buffers belong to the client and go with it.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+#include "SweetSurface.h"
+
+extern "C" {
+bool sweet_gpu_ready(void);
+int sweet_gpu_map_user(uint64_t *iova_out, const uint64_t *pages, uint32_t npages, uint32_t page_size);
+int sweet_gpu_submit_user(uint64_t ib_iova, uint32_t dwords, uint32_t timeout_ms, uint32_t *fence_out);
+void flush_dcache64(addr64_t addr, unsigned count, int phys);
+void sweet_gpu_service_selftest(void);
+}
+
+static IOLock *gSweetGPUMapLock;
+class SweetGPUService;
+static SweetGPUService *gSweetGPUService;        /* the shared page list in addMemory() and the GPU VA allocation */
+
+class SweetGPUService : public IOService {
+	OSDeclareDefaultStructors(SweetGPUService);
+
+public:
+	IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetGPUService, IOService);
+
+IOService *
+SweetGPUService::probe(IOService *provider, SInt32 *score)
+{
+	uint32_t on = 0, probeStage = 0;
+	PE_parse_boot_argn("sweetgpu", &on, sizeof(on));
+	PE_parse_boot_argn("sweetgpuprobe", &probeStage, sizeof(probeStage));
+	if (on == 0 && (probeStage == 16 || probeStage == 17)) {
+		on = 1;
+	}
+	return on ? IOService::probe(provider, score) : NULL;
+}
+
+bool
+SweetGPUService::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	if (gSweetGPUMapLock == NULL) {
+		gSweetGPUMapLock = IOLockAlloc();
+	}
+	if (gSweetGPUMapLock == NULL) {
+		return false;
+	}
+	gSweetGPUService = this;
+	setProperty("model", "Adreno 619");
+	setProperty(kIOUserClientClassKey, "SweetGPUUserClient");
+	registerService();
+	IOLog("SWEET GPU: SweetGPUService published\n");
+	return true;
+}
+
+/* ---- user client ---- */
+
+#define SWEET_GPU_MAX_BUFFERS   4096
+
+class SweetGPUUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetGPUUserClient);
+
+	task_t   fTask;
+	IOLock  *fLock;
+	OSArray *fMem;          /* index + 1 = handle; IOMemoryDescriptor, or kOSBooleanFalse once freed */
+	OSArray *fMaps;         /* same index: the kernel IOMemoryMap, for cache maintenance */
+
+	int addMemory(IOMemoryDescriptor *md, uint64_t *handle, uint64_t *va);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetGPUUserClient, IOUserClient);
+
+bool
+SweetGPUUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fLock = IOLockAlloc();
+	fMem = OSArray::withCapacity(64);
+	fMaps = OSArray::withCapacity(64);
+	return fLock != NULL && fMem != NULL && fMaps != NULL;
+}
+
+IOReturn
+SweetGPUUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+SweetGPUUserClient::free(void)
+{
+	if (fMem != NULL) {
+		for (unsigned i = 0; i < fMem->getCount(); i++) {
+			IOMemoryDescriptor *md = OSDynamicCast(IOMemoryDescriptor, fMem->getObject(i));
+			if (md != NULL) {
+				md->complete();
+			}
+		}
+	}
+	OSSafeReleaseNULL(fMem);
+	OSSafeReleaseNULL(fMaps);
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOUserClient::free();
+}
+
+/* Wire md, clean it, map its pages into the GPU, keep it. */
+int
+SweetGPUUserClient::addMemory(IOMemoryDescriptor *md, uint64_t *handle, uint64_t *va)
+{
+	static uint64_t pages[8192];
+	uint64_t len = md->getLength();
+	if (len == 0 || len > sizeof(pages) / sizeof(pages[0]) * PAGE_SIZE || md->prepare() != kIOReturnSuccess) {
+		return -1;
+	}
+	IOLockLock(gSweetGPUMapLock);
+	IOLockLock(fLock);
+	uint32_t n = 0;
+	bool ok = fMem->getCount() < SWEET_GPU_MAX_BUFFERS;
+	for (uint64_t off = 0; ok && off < len; off += PAGE_SIZE) {
+		IOByteCount seg = 0;
+		addr64_t pa = md->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+		ok = pa != 0 && (pa & PAGE_MASK) == 0;
+		pages[n++] = pa;
+	}
+	/* Clean the CPU's view to memory through a kernel mapping (the GPU does not snoop). */
+	IOMemoryMap *km = ok ? md->map() : NULL;
+	if (km != NULL) {
+		flush_dcache64((addr64_t)km->getVirtualAddress(), (unsigned)len, FALSE);
+	}
+	if (!ok || km == NULL || sweet_gpu_map_user(va, pages, n, PAGE_SIZE)) {
+		IOLockUnlock(fLock);
+		IOLockUnlock(gSweetGPUMapLock);
+		OSSafeReleaseNULL(km);
+		md->complete();
+		return -1;
+	}
+	fMaps->setObject(km);
+	km->release();
+	fMem->setObject(md);
+	*handle = fMem->getCount();
+	IOLockUnlock(fLock);
+	IOLockUnlock(gSweetGPUMapLock);
+	return 0;
+}
+
+IOReturn
+SweetGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	IOLockLock(fLock);
+	IOMemoryDescriptor *md = type >= 1 && type <= fMem->getCount() ?
+	    OSDynamicCast(IOMemoryDescriptor, fMem->getObject(type - 1)) : NULL;
+	if (md != NULL) {
+		md->retain();
+	}
+	IOLockUnlock(fLock);
+	if (md == NULL) {
+		return kIOReturnBadArgument;
+	}
+	/*
+	 * Default (cacheable) mapping. A write-combined one panicked in the cache mode change
+	 * ("phystokv_range: illegal PA"). The GPU does not snoop, so userland cleans what it wrote
+	 * (selector 5) before a submit and invalidates what it reads after.
+	 */
+	*options = (*options & ~kIOMapCacheMask) | kIOMapDefaultCache;
+	*memory = md;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	const uint64_t *in = args->scalarInput;
+	uint64_t *out = args->scalarOutput;
+	uint32_t nin = args->scalarInputCount;
+
+	switch (selector) {
+	case 0:
+		if (args->scalarOutputCount < 3) {
+			return kIOReturnBadArgument;
+		}
+		out[0] = 619;
+		out[1] = 0x06010901;
+		out[2] = sweet_gpu_ready();
+		return kIOReturnSuccess;
+	case 1: {
+		if (nin < 1 || args->scalarOutputCount < 3 || in[0] == 0 || in[0] > (1ULL << 30)) {
+			return kIOReturnBadArgument;
+		}
+		if (!sweet_gpu_ready()) {
+			return kIOReturnNotReady;
+		}
+		uint64_t size = round_page_64(in[0]);
+		IOBufferMemoryDescriptor *bmd = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared, size, PAGE_SIZE);
+		if (bmd == NULL) {
+			return kIOReturnNoMemory;
+		}
+		bzero(bmd->getBytesNoCopy(), size);
+		uint64_t handle = 0, va = 0;
+		int rc = addMemory(bmd, &handle, &va);
+		bmd->release();
+		if (rc) {
+			return kIOReturnNoResources;
+		}
+		out[0] = handle;
+		out[1] = va;
+		out[2] = size;
+		return kIOReturnSuccess;
+	}
+	case 2: {
+		if (nin < 1) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(fLock);
+		IOMemoryDescriptor *md = in[0] >= 1 && in[0] <= fMem->getCount() ?
+		    OSDynamicCast(IOMemoryDescriptor, fMem->getObject((unsigned)in[0] - 1)) : NULL;
+		if (md != NULL) {
+			md->complete();
+			fMem->replaceObject((unsigned)in[0] - 1, kOSBooleanFalse);
+			fMaps->replaceObject((unsigned)in[0] - 1, kOSBooleanFalse);
+		}
+		IOLockUnlock(fLock);
+		return md != NULL ? kIOReturnSuccess : kIOReturnBadArgument;
+	}
+	case 3: {
+		if (nin < 1 || args->scalarOutputCount < 3) {
+			return kIOReturnBadArgument;
+		}
+		if (!sweet_gpu_ready()) {
+			return kIOReturnNotReady;
+		}
+		SweetSurface *s = sweet_surface_copy((uint32_t)in[0]);
+		if (s == NULL || s->memory == NULL) {
+			OSSafeReleaseNULL(s);
+			return kIOReturnNotFound;
+		}
+		uint64_t handle = 0, va = 0;
+		int rc = addMemory(s->memory, &handle, &va);
+		out[2] = s->memory->getLength();
+		s->release();
+		if (rc) {
+			return kIOReturnNoResources;
+		}
+		out[0] = handle;
+		out[1] = va;
+		return kIOReturnSuccess;
+	}
+	case 4: {
+		if (nin < 3 || args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		if (!sweet_gpu_ready()) {
+			return kIOReturnNotReady;
+		}
+		uint32_t fence = 0;
+		int rc = sweet_gpu_submit_user(in[0], (uint32_t)in[1], (uint32_t)in[2], &fence);
+		out[0] = fence;
+		return rc ? kIOReturnTimeout : kIOReturnSuccess;
+	}
+	case 5: {
+		if (nin < 3) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(fLock);
+		IOMemoryMap *km = in[0] >= 1 && in[0] <= fMaps->getCount() ?
+		    OSDynamicCast(IOMemoryMap, fMaps->getObject((unsigned)in[0] - 1)) : NULL;
+		IOReturn ret = kIOReturnBadArgument;
+		if (km != NULL && in[1] < km->getLength() && in[2] <= km->getLength() - in[1]) {
+			flush_dcache64((addr64_t)(km->getVirtualAddress() + in[1]), (unsigned)in[2], FALSE);
+			ret = kIOReturnSuccess;
+		}
+		IOLockUnlock(fLock);
+		return ret;
+	}
+	default:
+		return kIOReturnUnsupported;
+	}
+}
+/*
+ * In-kernel exercise of the user client, called from the GPU thread when the boot-arg is sweetgpu=4 or more:
+ * it opens a client on the service like a process would, and drives selectors 0, 1, 5, 4, 5 and 2 with a
+ * command stream that makes the GPU write a word into the buffer. Needs no userland binary.
+ */
+extern "C" void
+sweet_gpu_service_selftest(void)
+{
+	if (gSweetGPUService == NULL) {
+		IOLog("SWEET GPUT: service not published, no selftest\n");
+		return;
+	}
+	/*
+	 * IOService::newUserClient() is unsupported here (a real open goes through IOServiceOpen, which then
+	 * instantiates the class named by kIOUserClientClassKey), so build the client the same way by hand.
+	 */
+	SweetGPUUserClient *client = OSTypeAlloc(SweetGPUUserClient);
+	if (client == NULL || !client->initWithTask(kernel_task, NULL, 0)) {
+		IOLog("SWEET GPUT: could not create the user client\n");
+		OSSafeReleaseNULL(client);
+		return;
+	}
+	if (!client->attach(gSweetGPUService) || !client->start(gSweetGPUService)) {
+		IOLog("SWEET GPUT: user client attach/start failed\n");
+		client->release();
+		return;
+	}
+	IOReturn r;
+	IOExternalMethodArguments a;
+	uint64_t in[3] = { 0, 0, 0 }, out[3] = { 0, 0, 0 };
+	bzero(&a, sizeof(a));
+	a.scalarInput = in;
+	a.scalarOutput = out;
+
+	a.scalarInputCount = 0;
+	a.scalarOutputCount = 3;
+	r = client->externalMethod(0, &a, NULL, NULL, NULL);
+	IOLog("SWEET GPUT: info -> 0x%x gpu %llu chip 0x%llx ready %llu\n", r, out[0], out[1], out[2]);
+
+	in[0] = 0x20000;
+	a.scalarInputCount = 1;
+	a.scalarOutputCount = 3;
+	r = client->externalMethod(1, &a, NULL, NULL, NULL);
+	const uint64_t handle = out[0], va = out[1];
+	IOLog("SWEET GPUT: alloc 0x20000 -> 0x%x handle %llu gpu va 0x%llx size 0x%llx\n", r, handle, va, out[2]);
+	if (r != kIOReturnSuccess) {
+		client->clientClose();
+		client->release();
+		return;
+	}
+
+	IOOptionBits opts = 0;
+	IOMemoryDescriptor *md = NULL;
+	IOMemoryMap *map = NULL;
+	if (client->clientMemoryForType((UInt32)handle, &opts, &md) == kIOReturnSuccess && md != NULL) {
+		map = md->map();
+	}
+	if (map == NULL) {
+		IOLog("SWEET GPUT: could not map the buffer\n");
+	} else {
+		volatile uint32_t *p = (volatile uint32_t *)map->getVirtualAddress();
+		const uint64_t target = va + 0x1000 + 0x20;
+		p[0] = 0x703d8003u;		/* CP_MEM_WRITE, 3 dwords */
+		p[1] = (uint32_t)target;
+		p[2] = (uint32_t)(target >> 32);
+		p[3] = 0x5ca1ab1eu;
+		p[0x1000 / 4 + 8] = 0;
+
+		in[0] = handle; in[1] = 0; in[2] = 0x20000;
+		a.scalarInputCount = 3;
+		r = client->externalMethod(5, &a, NULL, NULL, NULL);
+		IOLog("SWEET GPUT: cache flush (before) -> 0x%x\n", r);
+
+		in[0] = va; in[1] = 4; in[2] = 500;
+		a.scalarInputCount = 3;
+		a.scalarOutputCount = 1;
+		r = client->externalMethod(4, &a, NULL, NULL, NULL);
+		IOLog("SWEET GPUT: submit -> 0x%x fence %llu\n", r, out[0]);
+
+		in[0] = handle; in[1] = 0; in[2] = 0x20000;
+		a.scalarInputCount = 3;
+		(void)client->externalMethod(5, &a, NULL, NULL, NULL);
+		uint32_t v = p[0x1000 / 4 + 8];
+		IOLog("SWEET GPUT: word the GPU wrote = 0x%08x -> %s\n", v, v == 0x5ca1ab1eu ? "USER CLIENT WORKS" : "not written");
+		map->release();
+	}
+	if (md != NULL) {
+		md->release();
+	}
+
+	in[0] = handle;
+	a.scalarInputCount = 1;
+	r = client->externalMethod(2, &a, NULL, NULL, NULL);
+	IOLog("SWEET GPUT: free -> 0x%x\n", r);
+	client->clientClose();
+	client->release();
+	IOLog("SWEET GPUT: selftest done\n");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
