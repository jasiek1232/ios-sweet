 static uint32_t g_dh7[128], g_dh4, g_dtot;
 
+/*
+ * 0119: what the 2D blits of a slow job copy. The decoder keeps the last value written (type-4 packets) to the 2D engine's
+ * registers: GRAS_2D 0x8400-0x840f (0x8401-0x8404 source rectangle, 0x8405/0x8406 destination top-left/bottom-right as
+ * y << 16 | x), RB_2D 0x8c00-0x8c1f (0x8c17 destination format info, 0x8c18/0x8c19 its address, 0x8c1a its pitch) and
+ * SP_PS_2D_SRC 0xb4c0-0xb4cf (0xb4c0 source info, 0xb4c1 its size, 0xb4c2/0xb4c3 its address, 0xb4c4 its pitch), and at each
+ * CP_BLIT prints them for the first blits of a job, with the draws seen since the previous blit and the nesting depth.
+ */
+static uint32_t g_dg_r2d[48];		/* [0..15] 0x8400+, [16..31] 0x8c00+, [32..47] 0xb4c0+ */
+static uint32_t g_dg_blit_lines, g_dg_draws_since, g_dg_blit_dumps;
+static uint64_t g_dg_blit_px;		/* destination pixels of every blit of the job */
+static uint32_t g_dg_seq_now;
+
+static inline int
+g_dg_r2d_slot(uint32_t reg)
+{
+	if (reg >= 0x8400 && reg < 0x8410)
+		return (int)(reg - 0x8400);
+	if (reg >= 0x8c00 && reg < 0x8c20)
+		return 16 + (int)(reg - 0x8c00);
+	if (reg >= 0xb4c0 && reg < 0xb4d0)
+		return 32 + (int)(reg - 0xb4c0);
+	return -1;
+}
+
+static void
+g_dg_note_blit(uint32_t op, unsigned depth)
+{
+	uint32_t tl = g_dg_r2d[5], br = g_dg_r2d[6];
+	uint32_t w = ((br & 0x3fff) >= (tl & 0x3fff)) ? (br & 0x3fff) - (tl & 0x3fff) + 1 : 0;
+	uint32_t h = (((br >> 16) & 0x3fff) >= ((tl >> 16) & 0x3fff)) ? ((br >> 16) & 0x3fff) - ((tl >> 16) & 0x3fff) + 1 : 0;
+	g_dg_blit_px += (uint64_t)w * h;
+	if (g_dg_blit_lines < 14 && g_dg_blit_dumps <= 6) {
+		g_dg_blit_lines++;
+		printf("SWEET GPUBLT: seq %u blit op %u depth %u after %u draws: dst %ux%u at (%u,%u) info 0x%x addr 0x%x%08x pitch 0x%x; "
+		    "src rect x %u-%u y %u-%u info 0x%x size 0x%x addr 0x%x%08x pitch 0x%x; cntl gras 0x%x rb 0x%x\n",
+		    g_dg_seq_now, op, depth, g_dg_draws_since, w, h, tl & 0x3fff, (tl >> 16) & 0x3fff,
+		    g_dg_r2d[16 + 0x17], g_dg_r2d[16 + 0x19], g_dg_r2d[16 + 0x18], g_dg_r2d[16 + 0x1a],
+		    g_dg_r2d[1], g_dg_r2d[2], g_dg_r2d[3], g_dg_r2d[4],
+		    g_dg_r2d[32], g_dg_r2d[33], g_dg_r2d[35], g_dg_r2d[34], g_dg_r2d[36], g_dg_r2d[0], g_dg_r2d[16]);
+	}
+	g_dg_draws_since = 0;
+}
