+static void
+g_clear_fault(void)
+{
+	vm_offset_t cb = g_gpu_map(0x05948000ull);
+	if (!cb)
+		return;
+	uint32_t fsr = *(volatile uint32_t *)(cb + 0x58);
+	*(volatile uint32_t *)(cb + 0x58) = fsr;	/* a fault stops the GPU's writes until FSR is cleared */
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * After a hang or an SMMU fault: soft reset of the GPU core, then the CP up again (page tables, SMMU context
+ * bank and buffers are kept; the zap shader is still in TrustZone and is resumed, not reloaded). Submissions in
+ * flight are lost. 0 = the GPU works again.
+ */
+static int
+g_gpu_recover(void)
+{
+	volatile uint32_t *ring = (volatile uint32_t *)gp.ring.kva;
+	uint32_t wptr = 0;
+	uint64_t val = 0;
+	int rc = -1;
+
+	lck_mtx_lock(&g_svc_lock);
+	svc.ready = 0;
+	printf("SWEET GPUQ: recovering the GPU (soft reset)\n");
+	g_clear_fault();
+	g_gw("RBBM_SW_RESET_CMD", 0x43, 1);
+	g_settle(1);
+	g_gw("RBBM_SW_RESET_CMD", 0x43, 0);
+	g_settle(2);
+	g_clear_fault();
+	g_wrapper_up();
+	g_hw_regs();
+	for (unsigned i = 0; i < G_RING_DW; i++)
+		ring[i] = 0;
+	flush_dcache64((addr64_t)gp.ring.pa, 0x8000, TRUE);
+	g_gw64("CP_SQE_INSTR_BASE", 0x830, gp.sqe.iova);
+	g_gw64("CP_RB_BASE", 0x800, gp.ring.iova);
+	g_gw("CP_RB_CNTL", 0x802, 0x0800020cu);
+	g_gw("CP_RB_WPTR", 0x807, 0);
+	g_gw("CP_SQE_CNTL (start)", 0x808, 1);
+	g_settle(10);
+	const uint32_t init[9] = { G_PKT7(0x48, 8), 0x2f, 3, 0x20000000u, 0, 0, 0, 0, 0 };
+	const uint32_t sec[2] = { G_PKT7(0x66, 1), 0 };
+	if (g_ring_submit(ring, gp.ring.pa, &wptr, init, 9, "CP_ME_INIT (recovery)")) {
+		int zr = g_smc5(G_SCM_FN(0x01, 0x0a), 0x2, 0 /* resume */, G_ZAP_PAS, 0, &val);
+		printf("SWEET GPUQ: zap shader resume -> ret 0x%x\n", (unsigned)zr);
+		if (zr == 0 && g_ring_submit(ring, gp.ring.pa, &wptr, sec, 2, "CP_SET_SECURE_MODE(0) (recovery)")) {
+			svc.wptr = wptr;
+			rc = 0;
+		}
+	}
+	svc.ready = rc == 0;
+	lck_mtx_unlock(&g_svc_lock);
+	if (rc == 0) {
+		/* prove it: one fenced submission */
+		const uint32_t nop[1] = { G_PKT7(0x10, 0) };
+		uint32_t seq = 0;
+		if (sweet_gpu_submit(nop, 1, &seq) != 0 || sweet_gpu_wait(seq, 200) != 0) {
+			svc.ready = 0;
+			rc = -1;
+		}
+	}
+	printf("SWEET GPUQ: GPU recovery %s\n", rc == 0 ? "OK" : "FAILED, GPU left disabled");
+	return rc;
+}
