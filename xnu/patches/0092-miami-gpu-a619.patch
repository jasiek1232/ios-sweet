+/*
+ * Submission service (valid once the GPU is up, after the self test): queue a command stream on the ring and
+ * get a sequence number back; sweet_gpu_wait() polls until the GPU has executed everything up to that number.
+ * Each submission is followed by WAIT_FOR_IDLE and a CP_MEM_WRITE of its sequence number to a fence page.
+ * Returns 0 on success. Safe to call from several threads.
+ */
+int sweet_gpu_submit(const uint32_t *cmds, unsigned n, uint32_t *seq);
+int sweet_gpu_wait(uint32_t seq, unsigned timeout_ms);
+
+static int g_dbg;           /* sweetgpudebug=1 */
+static int g_sleep_chan;
+
+/* real sleep */
+static void
+g_settle(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&g_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* settle time between hardware steps: the full pause in debug mode, at most 25 ms otherwise */
+static void
+g_dwait(unsigned ms)
+{
+	g_settle(g_dbg ? ms : (ms > 25 ? 25 : ms));
+}
+
+/* pause that only exists so the log has flushed before a risky access: debug mode only */
+static void
+g_lwait(unsigned ms)
+{
+	if (g_dbg)
+		g_settle(ms);
+}
+
+#define g_vprintf(...) do { if (g_dbg) printf(__VA_ARGS__); } while (0)
+
+/*
+ * sweetgpuprobe=2: first power-up attempt. Clear SW_COLLAPSE on the GPU CX GDSC, then on GX,
+ * reading back each GDSCR (bit31 = PWR_ON). The GPU registers are only read when both domains
+ * report on; otherwise the thread stops with the GDSC status so nothing touches unpowered logic.
+ */
+static vm_offset_t
+g_gpu_map(uint64_t pa)
+{
+	/* ml_io_map never frees and the I/O VA aperture is small: cache one mapping per PA page. */
+	static struct { uint64_t page; vm_offset_t va; } cache[64];
+	static unsigned ncache;
+	uint64_t page = pa & ~0xfffULL;
+	for (unsigned i = 0; i < ncache; i++)
+		if (cache[i].page == page)
+			return cache[i].va + (vm_offset_t)(pa & 0xfffULL);
+	vm_offset_t base = ml_io_map((vm_offset_t)page, 0x1000);
+	if (!base)
+		return 0;
+	if (ncache < 64) {
+		cache[ncache].page = page;
+		cache[ncache].va = base;
+		ncache++;
+	}
+	return base + (vm_offset_t)(pa & 0xfffULL);
+}
+
+static int
+g_gdsc_on(const char *name, uint64_t pa)
+{
+	vm_offset_t va = g_gpu_map(pa);
+	if (!va) {
+		printf("SWEET GPUUP: %s map failed\n", name);
+		return 0;
+	}
+	uint32_t v = *(volatile uint32_t *)va;
+	printf("SWEET GPUUP: %s GDSCR before = 0x%08x\n", name, v);
+	g_dwait(1500);
+	printf("SWEET GPUUP: %s clearing SW_COLLAPSE ...\n", name);
+	g_dwait(1500);
+	*(volatile uint32_t *)va = v & ~1u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int i = 0; i < 20; i++) {
+		g_dwait(10);
+		v = *(volatile uint32_t *)va;
+		if (v & 0x80000000u) {
+			break;
+		}
+	}
+	printf("SWEET GPUUP: %s GDSCR after = 0x%08x (%s)\n", name, v, (v & 0x80000000u) ? "ON" : "still OFF");
+	g_dwait(1500);
+	return (v & 0x80000000u) != 0;
+}
+
+/*
+ * sweetgpuprobe=6: full GX power-up as in mainline gpucc-sm6375/gdsc.c: pulse the GX block
+ * resets, pulse the AON reset and drop the IO clamp, then clear SW_COLLAPSE and poll PWR_ON.
+ * Only the GPUCC registers are touched, never the GPU core itself.
+ */
+static void
+g_w32(const char *what, vm_offset_t va, uint32_t val)
+{
+	g_vprintf("SWEET GPUX: write %s <- 0x%08x ...\n", what, val);
+	g_lwait(200);
+	*(volatile uint32_t *)va = val;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	(void)*(volatile uint32_t *)va;
+}
+
+static int
+g_gx_sequence(void)
+{
+	vm_offset_t cc = g_gpu_map(0x05991000ULL) - 0;
+	vm_offset_t cc8 = g_gpu_map(0x05998000ULL);
+	if (!cc || !cc8) {
+		printf("SWEET GPUX: map failed\n");
+		return 0;
+	}
+	volatile uint32_t *gdscr = (volatile uint32_t *)(cc + 0x00c);
+	volatile uint32_t *cfg = (volatile uint32_t *)(cc + 0x010);
+	volatile uint32_t *bcr_gx = (volatile uint32_t *)(cc + 0x008);
+	volatile uint32_t *bcr_acd = (volatile uint32_t *)(cc + 0x160);
+	volatile uint32_t *bcr_misc = (volatile uint32_t *)(cc8 + 0x004);
+	volatile uint32_t *clamp = (volatile uint32_t *)(cc + 0x508);
+	printf("SWEET GPUX: start GDSCR 0x%08x CFG 0x%08x BCR 0x%08x/0x%08x/0x%08x clamp 0x%08x\n",
+	    *gdscr, *cfg, *bcr_gx, *bcr_acd, *bcr_misc, *clamp);
+	g_dwait(1000);
+	/* back to a clean collapsed state first */
+	g_w32("GX GDSCR collapse", (vm_offset_t)gdscr, *gdscr | 1u);
+	g_dwait(100);
+	printf("SWEET GPUX: GDSCR now 0x%08x CFG 0x%08x\n", *gdscr, *cfg);
+	g_dwait(500);
+	/* assert resets */
+	g_w32("GX_BCR assert", (vm_offset_t)bcr_gx, *bcr_gx | 1u);
+	g_w32("ACD_BCR assert", (vm_offset_t)bcr_acd, *bcr_acd | 1u);
+	g_w32("GX_ACD_MISC_BCR assert", (vm_offset_t)bcr_misc, *bcr_misc | 1u);
+	g_dwait(10);
+	g_w32("GX_BCR deassert", (vm_offset_t)bcr_gx, *bcr_gx & ~1u);
+	g_w32("ACD_BCR deassert", (vm_offset_t)bcr_acd, *bcr_acd & ~1u);
+	g_w32("GX_ACD_MISC_BCR deassert", (vm_offset_t)bcr_misc, *bcr_misc & ~1u);
+	g_dwait(500);
+	/* AON reset pulse (bit 4), then release the IO clamp (bit 0) */
+	g_w32("clamp_io AON reset", (vm_offset_t)clamp, *clamp | 0x10u);
+	g_dwait(5);
+	g_w32("clamp_io AON reset off", (vm_offset_t)clamp, *clamp & ~0x10u);
+	g_w32("clamp_io release", (vm_offset_t)clamp, *clamp & ~1u);
+	g_dwait(500);
+	printf("SWEET GPUX: clamp ctrl now 0x%08x\n", *clamp);
+	g_dwait(500);
+	g_w32("GX GDSCR enable", (vm_offset_t)gdscr, *gdscr & ~1u);
+	uint32_t v = 0;
+	for (int i = 0; i < 50; i++) {
+		g_dwait(10);
+		v = *gdscr;
+		if (v & 0x80000000u) {
+			break;
+		}
+	}
+	printf("SWEET GPUX: GX GDSCR = 0x%08x CFG 0x%08x (%s)\n", v, *cfg, (v & 0x80000000u) ? "ON" : "still OFF");
+	g_dwait(1500);
+	printf("SWEET GPUX: later GDSCR 0x%08x CFG 0x%08x\n", *gdscr, *cfg);
+	g_dwait(500);
+	return (*gdscr & 0x80000000u) != 0;
+}
+
+/*
+ * stage 9: bring up the GPU clock tree as mainline gpucc-sm6375 does: PLL0 (Lucid, L=0x1b
+ * alpha=0xb555 -> ~532 MHz), GX_GFX3D RCG (src PLL0, /2 -> 266 MHz), then the clock gates.
+ * Every write is announced first; the sequence stops at the first thing that doesn't lock.
+ */
+static void
+g_pw(const char *what, volatile uint32_t *reg, uint32_t val)
+{
+	g_vprintf("SWEET GPUK: %s <- 0x%08x\n", what, val);
+	g_lwait(120);
+	*reg = val;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static int
+g_gpu_clock_up(void)
+{
+	vm_offset_t p = g_gpu_map(0x05990000ULL);
+	vm_offset_t c = g_gpu_map(0x05991000ULL);
+	if (!p || !c) {
+		printf("SWEET GPUK: map failed\n");
+		return 0;
+	}
+	volatile uint32_t *mode = (volatile uint32_t *)(p + 0x00);
+	volatile uint32_t *r = (volatile uint32_t *)p;
+	printf("SWEET GPUK: PLL0 MODE 0x%08x STATUS 0x%08x\n", *mode, r[0x30 / 4]);
+	g_dwait(200);
+	g_pw("PLL0 L_VAL", &r[0x04 / 4], 0x1b);
+	g_pw("PLL0 CAL_L_VAL", &r[0x08 / 4], 0x44);
+	g_pw("PLL0 ALPHA", &r[0x40 / 4], 0xb555);
+	g_pw("PLL0 CONFIG_CTL", &r[0x18 / 4], 0x20485699);
+	g_pw("PLL0 CONFIG_CTL_U", &r[0x1c / 4], 0x00002261);
+	g_pw("PLL0 CONFIG_CTL_U1", &r[0x20 / 4], 0x329a299c);
+	g_pw("PLL0 USER_CTL", &r[0x0c / 4], 0x00000001);
+	g_pw("PLL0 USER_CTL_U", &r[0x10 / 4], 0x00000805);
+	g_pw("PLL0 USER_CTL_U1", &r[0x14 / 4], 0x00000000);
+	g_pw("PLL0 MODE update-bypass", mode, *mode | (1u << 23));
+	g_pw("PLL0 MODE outctrl off", mode, *mode & ~1u);
+	g_pw("PLL0 OPMODE standby", &r[0x38 / 4], 0);
+	g_pw("PLL0 MODE reset_n", mode, *mode | (1u << 2));
+	g_dwait(20);
+	printf("SWEET GPUK: PLL0 MODE 0x%08x STATUS 0x%08x (calibration bit27 %s)\n", *mode, r[0x30 / 4],
+	    (r[0x30 / 4] & (1u << 27)) ? "done" : "not done");
+	g_dwait(200);
+	g_pw("PLL0 OPMODE run", &r[0x38 / 4], 1);
+	uint32_t m = 0;
+	for (int i = 0; i < 100; i++) {
+		g_dwait(1);
+		m = *mode;
+		if (m & 0x80000000u) {
+			break;
+		}
+	}
+	printf("SWEET GPUK: PLL0 MODE 0x%08x STATUS 0x%08x -> %s\n", m, r[0x30 / 4], (m & 0x80000000u) ? "LOCKED" : "NO LOCK");
+	g_dwait(200);
+	if (!(m & 0x80000000u)) {
+		g_pw("PLL0 OPMODE standby (abort)", &r[0x38 / 4], 0);
+		return 0;
+	}
+	g_pw("PLL0 USER_CTL outputs", &r[0x0c / 4], r[0x0c / 4] | 7u);
+	g_pw("PLL0 MODE outctrl on", mode, *mode | 1u);
+	g_dwait(50);
+	volatile uint32_t *cc = (volatile uint32_t *)c;
+	/* GX_GFX3D RCG: source select 1 (PLL0), pre-div 2 -> hid_div field 3 */
+	g_pw("GX_GFX3D_SRC CFG", &cc[0x20 / 4], (1u << 8) | 3u);
+	g_pw("GX_GFX3D_SRC CMD update", &cc[0x1c / 4], cc[0x1c / 4] | 1u);
+	uint32_t cmd = 0;
+	for (int i = 0; i < 100; i++) {
+		g_dwait(1);
+		cmd = cc[0x1c / 4];
+		if (!(cmd & 1u)) {
+			break;
+		}
+	}
+	printf("SWEET GPUK: GX_GFX3D_SRC CMD 0x%08x (%s)\n", cmd, (cmd & 1u) ? "update STUCK" : "updated");
+	g_dwait(200);
+	if (cmd & 1u) {
+		return 0;
+	}
+	g_pw("GX_GFX3D_SRC CMD root_en", &cc[0x1c / 4], cc[0x1c / 4] | 2u);
+	g_dwait(20);
+	printf("SWEET GPUK: GX_GFX3D_SRC CMD 0x%08x CFG 0x%08x\n", cc[0x1c / 4], cc[0x20 / 4]);
+	g_dwait(200);
+	g_pw("GX_GFX3D CBCR enable", &cc[0x54 / 4], cc[0x54 / 4] | 1u);
+	g_dwait(20);
+	printf("SWEET GPUK: GX_GFX3D CBCR 0x%08x\n", cc[0x54 / 4]);
+	g_dwait(200);
+	g_pw("CX_GFX3D CBCR enable", &cc[0xa4 / 4], cc[0xa4 / 4] | 1u);
+	g_pw("CX_GFX3D_SLV CBCR enable", &cc[0xa8 / 4], cc[0xa8 / 4] | 1u);
+	g_dwait(20);
+	printf("SWEET GPUK: CX_GFX3D 0x%08x CX_GFX3D_SLV 0x%08x GX_GFX3D 0x%08x\n", cc[0xa4 / 4], cc[0xa8 / 4], cc[0x54 / 4]);
+	g_dwait(300);
+	return 1;
+}
