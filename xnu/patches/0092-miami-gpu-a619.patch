+	printf("SWEET GPUF: PAS_INIT_IMAGE(13) ...\n");
+	g_dwait(300);
+	rc = g_smc5(G_SCM_FN(0x02, 0x01), 0x82, G_ZAP_PAS, pa, 0, &val);
+	printf("SWEET GPUF: PAS_INIT_IMAGE -> ret 0x%x val 0x%llx\n", (unsigned)rc, (unsigned long long)val);
+	g_dwait(300);
+	if (rc != 0)
+		return;
