+__attribute__((optnone, noinline)) static void
+g_blit_test(void)
+{
+	volatile uint32_t *src = (volatile uint32_t *)gp.src.kva;
+	volatile uint32_t *dst = (volatile uint32_t *)gp.dst.kva;
+	const uint32_t *dw = g_blit_dw;
+	const unsigned n = sizeof(g_blit_dw) / sizeof(g_blit_dw[0]);
+	printf("SWEET GPUB: blit stream %u dwords\n", n);
+	g_dwait(150);
+	/* ml_io_map() panics when it cannot get the address space (a single 12 MiB mapping did), so map only the
+	 * 384 panel rows we draw into, in twelve small pieces of 32 rows (stride 4320 bytes, 4 bytes per pixel) */
+	vm_offset_t fbg[12];
+	printf("SWEET GPUB: mapping the panel rows ...\n");
+	g_dwait(300);
+	for (unsigned g = 0; g < 12; g++)
+		fbg[g] = ml_io_map(0x85200000ull + (uint64_t)(800 + g * 32) * 4320 + 348 * 4, 32 * 4320);
+	printf("SWEET GPUB: panel rows mapped\n");
+	g_dwait(300);
+	vm_offset_t st_va = g_gpu_map(G_CP_BASE + 0x210 * 4);
+	for (unsigned frame = 0; frame < 300; frame++) {
+		uint32_t blue = (frame * 6) & 0xffu;
+		for (unsigned y = 0; y < 128; y++)
+			for (unsigned x = 0; x < 128; x++)
+				src[y * 128 + x] = 0xff000000u | ((x * 2) << 16) | ((y * 2) << 8) | blue;
+		for (unsigned i = 0; i < 384 * 384; i++)
+			dst[i] = 0x00112233u;
+		flush_dcache64((addr64_t)gp.src.pa, 0x10000, TRUE);
+		flush_dcache64((addr64_t)gp.dst.pa, 0x90000, TRUE);
+		uint32_t seq = 0;
+		int ok = sweet_gpu_submit(dw, n, &seq) == 0 && sweet_gpu_wait(seq, 300) == 0;
+		uint32_t stv = 0;
+		for (int i = 0; i < 500; i++) {
+			stv = *(volatile uint32_t *)st_va;
+			if (!(stv & (1u << 23)))
+				break;
+			g_dwait(1);
+		}
+		flush_dcache64((addr64_t)gp.dst.pa, 0x90000, TRUE);
+		if (frame == 0) {
+			unsigned untouched = 0;
+			for (unsigned i = 0; i < 384 * 384; i++)
+				if (dst[i] == 0x00112233u)
+					untouched++;
+			printf("SWEET GPUB: RBBM_STATUS 0x%08x, ring %s, untouched dst pixels %u of %u\n", stv, ok ? "consumed" : "NOT consumed",
+			    untouched, 384u * 384u);
+			printf("SWEET GPUB: dst (0,0) 0x%08x (383,0) 0x%08x (0,383) 0x%08x (383,383) 0x%08x (192,192) 0x%08x\n",
+			    dst[0], dst[383], dst[383 * 384], dst[383 * 384 + 383], dst[192 * 384 + 192]);
+			printf("SWEET GPUB: expected centre about 0xff%02x%02x%02x (R,G from the gradient, B = %u)\n", 128, 128, blue, blue);
+			g_dwait(300);
+			if (untouched == 384u * 384u)
+				return;
+		}
+		for (unsigned y = 0; y < 384; y++) {
+			volatile uint32_t *f = (volatile uint32_t *)(fbg[y / 32] + (y % 32) * 4320);
+			for (unsigned x = 0; x < 384; x++)
+				f[x] = dst[y * 384 + x];
+		}
+		g_settle(33);
+	}
+	printf("SWEET GPUB: 300 frames drawn\n");
+	g_dwait(300);
+}
+
+__attribute__((optnone, noinline)) static void
+g_cp_test(int mode)
+{
+	const int blit = mode >= 2;
+	/* GCC clocks the GPU's memory path needs (Linux: gcc_gpu_cfg_ahb, gcc_gpu_memnoc_gfx, gcc_gpu_snoc_dvm_gfx) */
+	vm_offset_t gg = g_gpu_map(0x01436000ULL);
+	volatile uint32_t *gc = (volatile uint32_t *)gg;
+	printf("SWEET GPUR: GCC gpu_cfg_ahb 0x%08x memnoc_gfx 0x%08x snoc_dvm_gfx 0x%08x\n", gc[0x04 / 4], gc[0x0c / 4], gc[0x18 / 4]);
+	g_dwait(200);
+	g_pw("GCC gpu_cfg_ahb enable", &gc[0x04 / 4], gc[0x04 / 4] | 1u);
+	g_pw("GCC gpu_memnoc_gfx enable", &gc[0x0c / 4], gc[0x0c / 4] | 1u);
+	g_pw("GCC gpu_snoc_dvm_gfx enable", &gc[0x18 / 4], gc[0x18 / 4] | 1u);
+	g_dwait(50);
+	printf("SWEET GPUR: GCC gpu_cfg_ahb 0x%08x memnoc_gfx 0x%08x snoc_dvm_gfx 0x%08x (bit31 = still off)\n", gc[0x04 / 4], gc[0x0c / 4], gc[0x18 / 4]);
+	g_dwait(300);
+
+	g_hw_regs();
+
+	/* address space + buffer objects. The blit stream has the result page (0x4000), source (0x30000) and
+	 * destination (0x40000) addresses baked in, so those three use fixed IOVAs; SQE and ring are dynamic. */
+	if (!g_as_init())
+		return;
+	if (!g_bo_alloc(&gp.res, 0x4000, 0x1000) || !g_bo_alloc(&gp.sqe, 0, sizeof(g_sqe_fw) - 4) ||
+	    !g_bo_alloc(&gp.ring, 0, 0x8000) || !g_bo_alloc(&gp.fence, 0, 0x1000) ||
+	    (blit && (!g_bo_alloc(&gp.src, 0x30000, 0x10000) || !g_bo_alloc(&gp.dst, 0x40000, 0x90000)))) {
+		printf("SWEET GPUR: could not allocate the GPU buffers\n");
+		return;
+	}
+	/* the panel framebuffer (splash region, 12 MiB, 2 MiB aligned) as six 2 MiB blocks at IOVA 0x4000000, non-cacheable */
+	for (unsigned i = 0; i < 6; i++)
+		(void)g_as_map_2m(0x4000000ull + i * 0x200000ull, 0x85200000ull + i * 0x200000ull);
+	volatile uint32_t *res = (volatile uint32_t *)gp.res.kva;
+	volatile uint32_t *ring = (volatile uint32_t *)gp.ring.kva;
+	const uint64_t ring_pa = gp.ring.pa;
+	memcpy((void *)gp.sqe.kva, g_sqe_fw + 4, sizeof(g_sqe_fw) - 4);
+	res[0] = 0x11111111u;
+	g_bo_flush(&gp.res);
+	g_bo_flush(&gp.sqe);
+	g_bo_flush(&gp.ring);
+	g_bo_flush(&gp.fence);
+	g_as_sync();
+	printf("SWEET GPUR: page tables PA 0x%llx, SQE %u bytes at IOVA 0x%llx, ring at IOVA 0x%llx, first words 0x%08x 0x%08x\n",
+	    (unsigned long long)gp.pt_pa, (unsigned)(sizeof(g_sqe_fw) - 4), (unsigned long long)gp.sqe.iova,
+	    (unsigned long long)gp.ring.iova, *(volatile uint32_t *)gp.sqe.kva, *(volatile uint32_t *)(gp.sqe.kva + 4));
+	g_dwait(300);
+
+	const uint64_t base = 0x05940000ULL;
+	const uint64_t cb = base + 0x8000ULL;
+	g_smmu_wr("SMR0", base + 0x800, 0x80000000u);
+	g_smmu_wr("S2CR0", base + 0xc00, 0x00000000u);
+	g_smmu_wr("CBA2R0", base + 0x1800, 0x00000001u);
+	g_smmu_wr("CBAR0", base + 0x1000, (1u << 16) | (0xfu << 12) | (3u << 8));
+	g_smmu_wr("CB0 TTBR0 lo", cb + 0x20, (uint32_t)gp.pt_pa);
+	g_smmu_wr("CB0 TTBR0 hi", cb + 0x24, (uint32_t)((gp.pt_pa >> 32) | (1u << 16)));
+	/* PASIZE 2 (40-bit PA), SEP 7 = sign extension at the upstream address size (SEP 0 only accepts VAs below 2 GiB) */
+	g_smmu_wr("CB0 TCR2", cb + 0x10, 0x2u | (7u << 15));
+	g_smmu_wr("CB0 TCR", cb + 0x30, 0x80803519u);
+	g_smmu_wr("CB0 MAIR0", cb + 0x38, 0x000044ffu);   /* attr 0 write-back, attr 1 non-cacheable */
+	g_smmu_wr("CB0 MAIR1", cb + 0x3c, 0x0u);
+	g_smmu_wr("CB0 SCTLR", cb, 0x67u);
+
+	/* CP: microcode, ringbuffer, start */
+	g_gw64("CP_SQE_INSTR_BASE", 0x830, gp.sqe.iova);
+	g_gw64("CP_RB_BASE", 0x800, gp.ring.iova);
+	g_gw("CP_RB_CNTL", 0x802, 0x0800020cu);   /* 32 KiB ring, 32 byte blocks, no RPTR shadow */
+	g_gw("CP_RB_WPTR", 0x807, 0);
+	g_cp_state("before SQE start");
+	g_gw("CP_SQE_CNTL (start)", 0x808, 1);
+	g_dwait(50);
+	g_cp_state("after SQE start");
+
+	uint32_t wptr = 0;
+	const uint32_t init[9] = { G_PKT7(0x48, 8), 0x2f, 3, 0x20000000u, 0, 0, 0, 0, 0 };
+	if (!g_ring_submit(ring, ring_pa, &wptr, init, 9, "CP_ME_INIT")) {
+		g_cp_fail("after ME_INIT (not consumed)");
+		return;
+	}
+	g_cp_state("after ME_INIT");
+
+	printf("SWEET GPUR: loading the zap shader\n");
+	g_dwait(150);
+	g_zap_load();
+
+	const uint32_t sec[2] = { G_PKT7(0x66, 1), 0 };
+	(void)g_ring_submit(ring, ring_pa, &wptr, sec, 2, "CP_SET_SECURE_MODE(0)");
+	g_cp_state("after SET_SECURE_MODE");
+
+	const uint32_t wr[5] = { G_PKT7(0x3d, 3), 0x4000, 0, 0xcafebabeu, 0 };
+	(void)g_ring_submit(ring, ring_pa, &wptr, wr, 4, "CP_MEM_WRITE 0xcafebabe -> IOVA 0x4000");
+	flush_dcache64((addr64_t)gp.res.pa, 0x1000, TRUE);
+	uint32_t got = res[0];
+	printf("SWEET GPUR: result page word = 0x%08x -> %s\n", got, got == 0xcafebabeu ? "GPU WROTE MEMORY" : "not written");
+	g_dwait(150);
+	g_cp_state("end");
+	if (got != 0xcafebabeu)
+		return;
+	svc.rptr_va = g_gpu_map(G_CP_BASE + 0x806 * 4);
+	svc.wptr_va = g_gpu_map(G_CP_BASE + 0x807 * 4);
+	svc.wptr = wptr;
+	svc.seq = 0;
+	svc.ready = 1;
+	printf("SWEET GPUQ: submission service ready (ring wptr %u)\n", wptr);
+	{
+		/* 16 submissions queued back to back, one wait at the end: each writes its own word of the result page */
+		uint32_t seq = 0;
+		unsigned queued = 0, ok = 0;
+		for (unsigned i = 0; i < 16; i++) {
+			const uint32_t w[4] = { G_PKT7(0x3d, 3), 0x4100u + i * 4u, 0, 0x5a5a0000u + i };
+			if (sweet_gpu_submit(w, 4, &seq) != 0)
+				break;
+			queued++;
+		}
+		int wr = sweet_gpu_wait(seq, 500);
+		flush_dcache64((addr64_t)gp.res.pa, 0x1000, TRUE);
+		for (unsigned i = 0; i < queued; i++)
+			if (res[0x40 + i] == 0x5a5a0000u + i)
+				ok++;
+		printf("SWEET GPUQ: %u submissions queued, wait %s, %u of %u results correct, last seq %u\n", queued,
+		    wr == 0 ? "ok" : "TIMED OUT", ok, queued, seq);
+	}
+	if (blit)
+		g_blit_test();
+	g_user_probes();
+	if (mode >= 3) {
+		/* recovery test: a command stream at an address nothing maps faults the SMMU and wedges the CP */
+		uint32_t fence = 0, seq = 0;
+		const uint32_t w[4] = { G_PKT7(0x3d, 3), 0x4200u, 0, 0x600dbeefu };
+		printf("SWEET GPUQ: recovery test: running an indirect buffer at unmapped IOVA 0x300000000\n");
+		int sr = sweet_gpu_submit_user(0x300000000ull, 4, 500, &fence);
+		int ok = sweet_gpu_submit(w, 4, &seq) == 0 && sweet_gpu_wait(seq, 500) == 0;
+		flush_dcache64((addr64_t)gp.res.pa, 0x1000, TRUE);
+		uint32_t v = res[0x80];
+		printf("SWEET GPUQ: recovery test: faulting IB %s, later submit %s, word 0x%08x -> %s\n",
+		    sr ? "failed as expected" : "did NOT fail", ok ? "ok" : "FAILED", v,
+		    (ok && v == 0x600dbeefu) ? "GPU RECOVERED" : "not recovered");
+	}
+}
+
+static void
+g_cp_fail(const char *when)
+{
+	int o = g_dbg;
+	g_dbg = 1;
+	g_cp_state(when);
+	g_dbg = o;
+}
+
+static void
+g_gpu_thread(void *arg, wait_result_t w)
+{
+	int mode = (int)(uintptr_t)arg;
+	(void)w;
+	printf("SWEET GPUS: thread entered, mode %d%s, waiting 20 s\n", mode, g_dbg ? " (debug)" : "");
+	g_settle(20000);
+	printf("SWEET GPUS: start\n");
+	g_dwait(500);
+	if (g_gdsc_on("CX", 0x0599106cULL) && g_gx_sequence() && g_gpu_clock_up()) {
+		g_wrapper_up();
+		g_cp_test(mode);
+	} else {
+		printf("SWEET GPUS: power-up failed, stopping\n");
+	}
+	printf("SWEET GPUS: done\n");
+	(void)thread_terminate(current_thread());
+}
+
+void
+sweet_gpu_a619_start(void)
+{
+	int mode = 0, dbg = 0, probe = 0;
+	thread_t thread;
+	PE_parse_boot_argn("sweetgpu", &mode, sizeof(mode));
+	PE_parse_boot_argn("sweetgpuprobe", &probe, sizeof(probe));
+	PE_parse_boot_argn("sweetgpudebug", &dbg, sizeof(dbg));
+	if (mode == 0 && (probe == 16 || probe == 17))
+		mode = probe - 15;
+	if (mode <= 0)
+		return;
+	g_dbg = dbg;
+	if (kernel_thread_start(g_gpu_thread, (void *)(uintptr_t)mode, &thread) == KERN_SUCCESS)
+		thread_deallocate(thread);
+	else
+		printf("SWEET GPUS: kernel_thread_start failed\n");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
