+/*
+ * stage 15: the Linux resume path of a GMU-wrapper A619 (holi): a6xx_pm_resume() enables the GMU clock,
+ * then hw_init() clears the GBIF halt, GPR0 and TSB control and calls a6xx_sptprac_enable(), which
+ * writes GMU_GX_SPTPRAC_POWER_CONTROL = 0x778000 and polls GMU_SPTPRAC_PWR_CLK_STATUS for (v & 0x38) == 0x28.
+ * GMU block registers sit at GPU base + dword offset * 4 (mainline a6xx_gmu.xml, GPU-relative):
+ *   GMU_GX_SPTPRAC_POWER_CONTROL 0x1a881 -> 0x0596a204, GMU_SPTPRAC_PWR_CLK_STATUS 0x1f8d0 -> 0x0597e340.
+ * The GMU clock goes to the 19.2 MHz reference (no GCC GPLL0 vote needed); the wrapper has no GMU CPU,
+ * only the register block needs a clock. Every access prints before it happens.
+ */
+static void
+g_wrapper_up(void)
+{
+	vm_offset_t c = g_gpu_map(0x05991000ULL);
+	if (!c) {
+		printf("SWEET GPUG: map failed\n");
+		return;
+	}
+	volatile uint32_t *cc = (volatile uint32_t *)c;
+	(void)g_smmu_r("RBBM_STATUS before", 0x05900840ULL);
+	printf("SWEET GPUG: CBCR AHB 0x%08x CXO 0x%08x CX_GMU 0x%08x GX_GMU 0x%08x GMU_SRC CMD 0x%08x CFG 0x%08x\n",
+	    cc[0x78 / 4], cc[0x9c / 4], cc[0x98 / 4], cc[0x64 / 4], cc[0x120 / 4], cc[0x124 / 4]);
+	g_dwait(200);
+	g_pw("GPUCC AHB CBCR enable", &cc[0x78 / 4], cc[0x78 / 4] | 1u);
+	g_pw("GPUCC CXO CBCR enable", &cc[0x9c / 4], cc[0x9c / 4] | 1u);
+	g_pw("GMU_SRC CFG (XO, no divider)", &cc[0x124 / 4], 0);
+	g_pw("GMU_SRC CMD update", &cc[0x120 / 4], cc[0x120 / 4] | 1u);
+	uint32_t cmd = 0;
+	for (int i = 0; i < 100; i++) {
+		g_dwait(1);
+		cmd = cc[0x120 / 4];
+		if (!(cmd & 1u))
+			break;
+	}
+	printf("SWEET GPUG: GMU_SRC CMD 0x%08x (%s)\n", cmd, (cmd & 1u) ? "update STUCK" : "updated");
+	g_dwait(200);
+	if (cmd & 1u)
+		return;
+	g_pw("GMU_SRC CMD root_en", &cc[0x120 / 4], cc[0x120 / 4] | 2u);
+	g_pw("CX_GMU CBCR enable", &cc[0x98 / 4], cc[0x98 / 4] | 1u);
+	g_pw("GX_GMU CBCR enable", &cc[0x64 / 4], cc[0x64 / 4] | 1u);
+	g_dwait(20);
+	printf("SWEET GPUG: CX_GMU 0x%08x GX_GMU 0x%08x GMU_SRC 0x%08x (bit31 of a CBCR = clock still off)\n",
+	    cc[0x98 / 4], cc[0x64 / 4], cc[0x120 / 4]);
+	g_dwait(300);
+
+	uint32_t st = g_smmu_r("GMU_SPTPRAC_PWR_CLK_STATUS before", 0x0597e340ULL);
+	g_smmu_wr("GBIF_HALT", 0x0590f114ULL, 0);
+	g_smmu_wr("RBBM_GPR0_CNTL", 0x05900060ULL, 0);
+	g_smmu_wr("RBBM_SECVID_TSB_CNTL", 0x0593e00cULL, 0);
+	g_smmu_wr("GMU_GX_SPTPRAC_POWER_CONTROL", 0x0596a204ULL, 0x778000u);
+	vm_offset_t sv = g_gpu_map(0x0597e340ULL);
+	for (int i = 0; i < 100; i++) {
+		g_dwait(1);
+		st = *(volatile uint32_t *)sv;
+		if ((st & 0x38u) == 0x28u)
+			break;
+	}
+	printf("SWEET GPUG: SPTPRAC status 0x%08x -> %s\n", st, ((st & 0x38u) == 0x28u) ? "SPTPRAC ON" : "SPTPRAC NOT ON");
+	g_dwait(300);
+	(void)g_smmu_r("RBBM_STATUS after", 0x05900840ULL);
+}
