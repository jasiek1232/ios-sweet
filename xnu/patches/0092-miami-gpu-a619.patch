+/* make the table writes visible to the SMMU's table walker */
+static void
+g_as_sync(void)
+{
+	flush_dcache64((addr64_t)gp.pt_pa, ((gp.pt_used * 0x1000u) + PAGE_MASK) & ~(unsigned)PAGE_MASK, TRUE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* allocate and map a BO; iova_fixed == 0 takes the next dynamic IOVA */
+static int
+g_bo_alloc(struct g_bo *bo, uint64_t iova_fixed, size_t size)
+{
+	size_t map = (size + 0xfffu) & ~(size_t)0xfffu;
+	size_t alloc = (size + PAGE_MASK) & ~(size_t)PAGE_MASK;
+	vm_offset_t mem = 0;
+	if (kmem_alloc_contig(kernel_map, &mem, alloc, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET GPUA: no memory for a %lu byte BO\n", (unsigned long)size);
+		return 0;
+	}
+	uint64_t iova = iova_fixed;
+	if (!iova) {
+		iova = gp.next_iova;
+		if (iova + map + 0x1000 > G_IOVA_END) {
+			printf("SWEET GPUA: out of IOVA space\n");
+			return 0;
+		}
+		gp.next_iova = iova + map + 0x1000;	/* one unmapped guard page after each BO */
+	}
+	bo->kva = mem;
+	bo->pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)mem));
+	bo->iova = iova;
+	bo->size = size;
+	if (!g_as_map(iova, bo->pa, map, G_PTE_PAGE_WB))
+		return 0;
+	g_vprintf("SWEET GPUA: BO iova 0x%llx pa 0x%llx size 0x%lx\n", (unsigned long long)iova,
+	    (unsigned long long)bo->pa, (unsigned long)size);
+	return 1;
+}
+
+static void
+g_bo_flush(const struct g_bo *bo)
+{
+	flush_dcache64((addr64_t)bo->pa, (unsigned)((bo->size + PAGE_MASK) & ~(size_t)PAGE_MASK), TRUE);
+}
