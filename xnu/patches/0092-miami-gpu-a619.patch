+/*
+ * GPU address space manager. The A619's kgsl SMMU context bank 0 walks 4 KiB-granule, 39-bit page tables
+ * (TCR 0x80803519: L1 1 GiB entries -> L2 2 MiB entries -> L3 4 KiB pages). All table pages come from one
+ * zeroed pool; L2/L3 pages are added on demand. Buffer objects (BOs) are physically contiguous kernel
+ * allocations mapped at an IOVA: dynamic IOVAs come from a bump allocator starting at G_IOVA_ARENA, fixed
+ * IOVAs are for the A2D blit demo whose command stream has its addresses baked in. Nothing is ever freed yet.
+ */
+#define G_PT_PAGES	512u		/* 4 KiB table pages in the pool (2 MiB) */
+#define G_IOVA_ARENA	0x00100000ull	/* dynamic allocations start here; below is the fixed demo layout */
+#define G_IOVA_END	0x04000000ull	/* the panel framebuffer blocks live at this IOVA */
+#define G_PTE_PAGE_WB	0x743ull	/* valid page, attr0 (write-back), inner shareable, AF */
+#define G_PTE_PAGE_NC	0x747ull	/* the same with attr1 (non-cacheable) */
+#define G_PTE_BLOCK_NC	0x745ull	/* 2 MiB block, attr1 */
+
+struct g_bo {
+	vm_offset_t kva;
+	uint64_t pa;
+	uint64_t iova;
+	size_t size;
+};
+
+static struct {
+	vm_offset_t pt_kva;
+	uint64_t pt_pa;
+	unsigned pt_used;
+	uint64_t next_iova;
+	struct g_bo res, sqe, ring, fence, src, dst;
+} gp;
+
+static int
+g_as_init(void)
+{
+	vm_offset_t mem = 0;
+	if (gp.pt_kva)
+		return 1;
+	if (kmem_alloc_contig(kernel_map, &mem, G_PT_PAGES * 0x1000u, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET GPUA: no memory for the page tables\n");
+		return 0;
+	}
+	gp.pt_kva = mem;
+	gp.pt_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)mem));
+	gp.pt_used = 1;		/* page 0 is the L1 table */
+	gp.next_iova = G_IOVA_ARENA;
+	return 1;
+}
+
+/* the entry of a table, creating the next-level table page when it is still empty */
+static volatile uint64_t *
+g_as_next(volatile uint64_t *tbl, unsigned idx)
+{
+	if (!(tbl[idx] & 1ull)) {
+		if (gp.pt_used >= G_PT_PAGES) {
+			printf("SWEET GPUA: page-table pool exhausted\n");
+			return NULL;
+		}
+		uint64_t pa = gp.pt_pa + (uint64_t)gp.pt_used * 0x1000u;
+		gp.pt_used++;
+		tbl[idx] = pa | 3ull;
+	}
+	uint64_t pa = tbl[idx] & 0x0000fffffffff000ull;
+	return (volatile uint64_t *)(gp.pt_kva + (vm_offset_t)(pa - gp.pt_pa));
+}
+
+static int
+g_as_map(uint64_t iova, uint64_t pa, size_t size, uint64_t pte)
+{
+	volatile uint64_t *l1 = (volatile uint64_t *)gp.pt_kva;
+	for (size_t off = 0; off < size; off += 0x1000) {
+		uint64_t v = iova + off;
+		volatile uint64_t *l2 = g_as_next(l1, (unsigned)((v >> 30) & 0x1ff));
+		volatile uint64_t *l3 = l2 ? g_as_next(l2, (unsigned)((v >> 21) & 0x1ff)) : NULL;
+		if (!l3)
+			return 0;
+		l3[(v >> 12) & 0x1ff] = (pa + off) | pte;
+	}
+	return 1;
+}
+
+static int
+g_as_map_2m(uint64_t iova, uint64_t pa)
+{
+	volatile uint64_t *l1 = (volatile uint64_t *)gp.pt_kva;
+	volatile uint64_t *l2 = g_as_next(l1, (unsigned)((iova >> 30) & 0x1ff));
+	if (!l2)
+		return 0;
+	l2[(iova >> 21) & 0x1ff] = pa | G_PTE_BLOCK_NC;
+	return 1;
+}
