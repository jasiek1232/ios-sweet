+/*
+ * stage 16: first real GPU command path (Linux a6xx hw_init + a6xx_cp_init + zap + a write packet).
+ * Layout of one physically contiguous block (CPU view and GPU IOVA view are the same offsets):
+ *   0x00000 L1 table, 0x01000 L2 table, 0x02000 L3 table (IOVA 0..2 MiB, 4 KiB pages)
+ *   0x04000 result page   0x10000 SQE microcode (a630_sqe.fw minus its 4 byte header)   0x20000 ringbuffer (32 KiB)
+ * Every register write prints before it happens.
+ */
+#define G_CP_BASE	0x05900000ull
+#define G_PM4_PAR(v)	((0x9669u >> (0xfu & ((v) ^ ((v) >> 4) ^ ((v) >> 8) ^ ((v) >> 12) ^ ((v) >> 16)))) & 1u)
+#define G_PKT7(op, cnt)	(0x70000000u | (cnt) | (G_PM4_PAR(cnt) << 15) | (((op) & 0x7fu) << 16) | (G_PM4_PAR(op) << 23))
+
+static void
+g_gw(const char *name, uint32_t dw, uint32_t val)
+{
+	g_smmu_wr(name, G_CP_BASE + (uint64_t)dw * 4, val);
+}
+
+static void
+g_gw64(const char *name, uint32_t dw, uint64_t val)
+{
+	g_gw(name, dw, (uint32_t)val);
+	g_gw(name, dw + 1, (uint32_t)(val >> 32));
+}
+
+static void
+g_cp_state(const char *when)
+{
+	g_vprintf("SWEET GPUR: ---- CP state %s ----\n", when);
+	(void)g_smmu_r("RBBM_STATUS", G_CP_BASE + 0x210 * 4);
+	(void)g_smmu_r("RBBM_INT_0_STATUS", G_CP_BASE + 0x201 * 4);
+	(void)g_smmu_r("CP_HW_FAULT", G_CP_BASE + 0x821 * 4);
+	(void)g_smmu_r("CP_RB_RPTR", G_CP_BASE + 0x806 * 4);
+	(void)g_smmu_r("CB0 FSR", 0x05948000ull + 0x58);
+	(void)g_smmu_r("sGFSR", 0x05940000ull + 0x48);
+}
+
+static void g_cp_fail(const char *when);
+__attribute__((optnone, noinline)) static int
+g_ring_submit(volatile uint32_t *ring, uint64_t ring_pa, uint32_t *wptr, const uint32_t *pkt, unsigned n, const char *what)
+{
+	for (unsigned i = 0; i < n; i++)
+		ring[(*wptr + i) % 0x2000] = pkt[i];
+	flush_dcache64((addr64_t)ring_pa, 0x8000, TRUE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*wptr = (*wptr + n) % 0x2000;
+	vm_offset_t rptr_va = g_gpu_map(G_CP_BASE + 0x806 * 4);
+	g_vprintf("SWEET GPUR: submit %s (%u dwords, wptr -> %u) ...\n", what, n, *wptr);
+	g_lwait(150);
+	g_gw("CP_RB_WPTR", 0x807, *wptr);
+	uint32_t rp = 0;
+	for (int i = 0; i < 300; i++) {
+		g_dwait(1);
+		rp = *(volatile uint32_t *)rptr_va;
+		if (rp == *wptr)
+			break;
+	}
+	if (g_dbg || rp != *wptr)
+		printf("SWEET GPUR: %s: RPTR %u WPTR %u -> %s\n", what, rp, *wptr, rp == *wptr ? "CONSUMED" : "NOT consumed");
+	g_lwait(150);
+	return rp == *wptr;
+}
+
+#define G_RING_DW 0x2000u
+
+__attribute__((optnone, noinline)) int
+sweet_gpu_submit(const uint32_t *cmds, unsigned n, uint32_t *seq_out)
+{
+	volatile uint32_t *ring = (volatile uint32_t *)gp.ring.kva;
+	const unsigned total = n + 5;	/* + WAIT_FOR_IDLE (1) + CP_MEM_WRITE fence (4) */
+	unsigned tries = 0;
+
+	if (!svc.ready || n == 0 || total > G_RING_DW / 2)
+		return -1;
+	for (;;) {
+		lck_mtx_lock(&g_svc_lock);
+		uint32_t rp = *(volatile uint32_t *)svc.rptr_va;
+		uint32_t used = (svc.wptr - rp) & (G_RING_DW - 1);
+		if (G_RING_DW - 1 - used >= total)
+			break;		/* enough room; the lock stays held */
+		lck_mtx_unlock(&g_svc_lock);
+		if (++tries > 5000)
+			return -2;	/* ring stayed full for ~5 s: the GPU is stuck */
+		g_settle(1);
+	}
+	uint32_t w = svc.wptr;
+	for (unsigned i = 0; i < n; i++)
+		ring[(w + i) & (G_RING_DW - 1)] = cmds[i];
+	w += n;
+	const uint32_t seq = ++svc.seq;
+	const uint32_t tail[5] = { G_PKT7(0x26, 0), G_PKT7(0x3d, 3), (uint32_t)gp.fence.iova,
+		(uint32_t)(gp.fence.iova >> 32), seq };
+	for (unsigned i = 0; i < 5; i++)
+		ring[(w + i) & (G_RING_DW - 1)] = tail[i];
+	w += 5;
+	flush_dcache64((addr64_t)gp.ring.pa, 0x8000, TRUE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	svc.wptr = w & (G_RING_DW - 1);
+	*(volatile uint32_t *)svc.wptr_va = svc.wptr;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	lck_mtx_unlock(&g_svc_lock);
+	*seq_out = seq;
+	return 0;
+}
+
+__attribute__((optnone, noinline)) int
+sweet_gpu_wait(uint32_t seq, unsigned timeout_ms)
+{
+	volatile uint32_t *f = (volatile uint32_t *)gp.fence.kva;
+	for (unsigned i = 0; i <= timeout_ms; i++) {
+		flush_dcache64((addr64_t)gp.fence.pa, 0x1000, TRUE);
+		if ((int32_t)(*f - seq) >= 0)
+			return 0;
+		g_settle(1);
+	}
+	return -1;
+}
+
+/* ---- buffers and submissions for the IOKit user client (iokit/Kernel/arm/SweetGPUService.cpp) ---- */
+
+/*
+ * Client address space: from G_USER_A_BASE up to the highest address the boot-time probes (g_user_probes) got the
+ * GPU to translate. The arena starts empty, so user mapping is disabled until a probe passed.
+ */
+#define G_USER_A_BASE	0x010000000ull	/* 256 MiB: first-level index 0, like all kernel mappings */
+#define G_USER_VA_ALIGN	0x10000ull
+
+static uint64_t g_user_next = G_USER_A_BASE;
+static uint64_t g_user_end;	/* 0 until a probe passed */
+
+bool sweet_gpu_ready(void);
+int sweet_gpu_map_user(uint64_t *iova_out, const uint64_t *pages, uint32_t npages, uint32_t page_size);
+int sweet_gpu_submit_user(uint64_t ib_iova, uint32_t dwords, uint32_t timeout_ms, uint32_t *fence_out);
+
+bool
+sweet_gpu_ready(void)
+{
+	return svc.ready != 0;
+}
+
+/* invalidate the context bank's TLB (TLBIALL, then TLBSYNC and poll TLBSTATUS.GSACTIVE) */
+static void
+g_tlb_flush(void)
+{
+	vm_offset_t cb = g_gpu_map(0x05948000ull);
+	if (!cb)
+		return;
+	*(volatile uint32_t *)(cb + 0x618) = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(cb + 0x7f0) = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int i = 0; i < 10000; i++)
+		if (!(*(volatile uint32_t *)(cb + 0x7f4) & 1u))
+			break;
+}
+
+/*
+ * Map physical pages at a fresh GPU address. The VA is never reused yet: freed buffers leak their VA and
+ * their table pages. The caller has already cleaned the CPU caches (the GPU does not snoop).
+ */
+int
+sweet_gpu_map_user(uint64_t *iova_out, const uint64_t *pages, uint32_t npages, uint32_t page_size)
+{
+	if (!svc.ready || npages == 0 || (page_size & 0xfffu))
+		return -1;
+	uint64_t size = (uint64_t)npages * page_size;
+	lck_mtx_lock(&g_svc_lock);
+	uint64_t iova = g_user_next;
+	if (iova + size > g_user_end) {
+		lck_mtx_unlock(&g_svc_lock);
+		return -1;
+	}
+	for (uint32_t i = 0; i < npages; i++) {
+		if (!g_as_map(iova + (uint64_t)i * page_size, pages[i], page_size, G_PTE_PAGE_WB)) {
+			lck_mtx_unlock(&g_svc_lock);
+			return -1;
+		}
+	}
+	g_user_next = (iova + size + G_USER_VA_ALIGN - 1) & ~(G_USER_VA_ALIGN - 1);
+	g_as_sync();
+	g_tlb_flush();
+	lck_mtx_unlock(&g_svc_lock);
+	*iova_out = iova;
+	return 0;
+}
+
+/* Run an indirect buffer (user GPU memory) and wait for it: 0, or -1 on a hang or fault (the fault is cleared). */
+int
+sweet_gpu_submit_user(uint64_t ib_iova, uint32_t dwords, uint32_t timeout_ms, uint32_t *fence_out)
+{
+	const uint32_t pkt[4] = { G_PKT7(0x3f, 3), (uint32_t)ib_iova, (uint32_t)(ib_iova >> 32), dwords };
+	uint32_t seq = 0;
+	*fence_out = 0;
+	if (sweet_gpu_submit(pkt, 4, &seq) != 0)
+		return -1;
+	int rc = sweet_gpu_wait(seq, timeout_ms ? timeout_ms : 1000);
+	*fence_out = seq;
+	if (rc) {
+		vm_offset_t cb = g_gpu_map(0x05948000ull);
+		if (cb) {
+			uint32_t fsr = *(volatile uint32_t *)(cb + 0x58);
+			uint64_t far = *(volatile uint32_t *)(cb + 0x60) | ((uint64_t)*(volatile uint32_t *)(cb + 0x64) << 32);
+			uint32_t syn = *(volatile uint32_t *)(cb + 0x68);
+			printf("SWEET GPUQ: user IB %llx (%u dwords) timed out: smmu fsr 0x%x far 0x%llx fsynr0 0x%x\n",
+			    (unsigned long long)ib_iova, dwords, fsr, (unsigned long long)far, syn);
+		}
+		(void)g_gpu_recover();
+	}
+	return rc;
+}
+
+/* one probe: map two pages at iova, run an indirect buffer there that writes a word into the second page */
+static int
+g_user_probe(uint64_t iova, vm_offset_t um, uint64_t upa, uint32_t magic)
+{
+	volatile uint32_t *ib = (volatile uint32_t *)um;
+	const uint64_t target = iova + PAGE_SIZE + 0x10;
+	uint32_t fence = 0;
+	for (unsigned i = 0; i < 2; i++)
+		if (!g_as_map(iova + (uint64_t)i * PAGE_SIZE, upa + (uint64_t)i * PAGE_SIZE, PAGE_SIZE, G_PTE_PAGE_WB)) {
+			printf("SWEET GPUQ: probe at IOVA 0x%llx: out of table pages\n", (unsigned long long)iova);
+			return 0;
+		}
+	g_as_sync();
+	g_tlb_flush();
+	{
+		volatile uint64_t *l1 = (volatile uint64_t *)gp.pt_kva;
+		uint64_t e1 = l1[(iova >> 30) & 0x1ff];
+		volatile uint64_t *l2 = (volatile uint64_t *)(gp.pt_kva + (vm_offset_t)((e1 & 0x0000fffffffff000ull) - gp.pt_pa));
+		uint64_t e2 = l2[(iova >> 21) & 0x1ff];
+		volatile uint64_t *l3 = (volatile uint64_t *)(gp.pt_kva + (vm_offset_t)((e2 & 0x0000fffffffff000ull) - gp.pt_pa));
+		printf("SWEET GPUQ: probe at IOVA 0x%llx: L1[%u]=0x%llx L2[%u]=0x%llx L3[%u]=0x%llx\n", (unsigned long long)iova,
+		    (unsigned)((iova >> 30) & 0x1ff), (unsigned long long)e1, (unsigned)((iova >> 21) & 0x1ff),
+		    (unsigned long long)e2, (unsigned)((iova >> 12) & 0x1ff), (unsigned long long)l3[(iova >> 12) & 0x1ff]);
+	}
+	ib[0] = G_PKT7(0x3d, 3);
+	ib[1] = (uint32_t)target;
+	ib[2] = (uint32_t)(target >> 32);
+	ib[3] = magic;
+	*(volatile uint32_t *)(um + PAGE_SIZE + 0x10) = 0;
+	flush_dcache64((addr64_t)upa, 2 * PAGE_SIZE, TRUE);
+	int sr = sweet_gpu_submit_user(iova, 4, 500, &fence);
+	flush_dcache64((addr64_t)upa, 2 * PAGE_SIZE, TRUE);
+	uint32_t v = *(volatile uint32_t *)(um + PAGE_SIZE + 0x10);
+	int ok = (sr == 0 && v == magic);
+	printf("SWEET GPUQ: user IB probe at IOVA 0x%llx: submit %s, word 0x%08x -> %s\n", (unsigned long long)iova,
+	    sr == 0 ? "ok" : "FAILED", v, ok ? "WORKS" : "not written");
+	return ok;
+}
+
+/*
+ * Find out how far up the GPU translates, probing from low to high and stopping at the first miss (a fault
+ * wedges the CP, so this runs after the demo). The arena then spans from G_USER_A_BASE to the last pass.
+ */
+static void
+g_user_probes(void)
+{
+	static const uint64_t cand[] = { 0x3ff00000ull, 0xfff00000ull, 0x200000000ull, 0x7eff000000ull };
+	vm_offset_t um = 0;
+	if (kmem_alloc_contig(kernel_map, &um, 2 * PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS)
+		return;
+	uint64_t upa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)um));
+	for (unsigned i = 0; i < sizeof(cand) / sizeof(cand[0]); i++) {
+		if (!g_user_probe(cand[i], um, upa, 0xfeed0001u + i))
+			break;
+		g_user_end = cand[i];
+	}
+	if (g_user_end)
+		printf("SWEET GPUQ: client arena 0x%llx-0x%llx\n", (unsigned long long)g_user_next,
+		    (unsigned long long)g_user_end);
+	else
+		printf("SWEET GPUQ: client mappings stay disabled\n");
+}
