+/* GPU use per client process: a line every 250 submits, so a log shows who really renders on the GPU */
+struct sweet_v2_stat {
+	char name[24];
+	uint32_t submits, busy, failed;
+};
+static struct sweet_v2_stat sweet_v2_stats[8];
+static uint32_t sweet_v2_total;
+static IOLock *sweet_v2_stat_lock;
+
+static void
+sweet_v2_note_submit(IOReturn r)
+{
+	char who[24] = "";
+	proc_selfname(who, sizeof(who));
+	if (sweet_v2_stat_lock == NULL) {
+		sweet_v2_stat_lock = IOLockAlloc();
+		if (sweet_v2_stat_lock == NULL) {
+			return;
+		}
+	}
+	IOLockLock(sweet_v2_stat_lock);
+	struct sweet_v2_stat *e = NULL;
+	for (unsigned i = 0; i < 8; i++) {
+		if (sweet_v2_stats[i].name[0] == 0 || strncmp(sweet_v2_stats[i].name, who, sizeof(who)) == 0) {
+			e = &sweet_v2_stats[i];
+			break;
+		}
+	}
+	if (e != NULL) {
+		strlcpy(e->name, who, sizeof(e->name));
+		e->submits++;
+		if (r == kIOReturnBusy) {
+			e->busy++;
+		} else if (r != kIOReturnSuccess) {
+			e->failed++;
+		}
+	}
+	if (++sweet_v2_total % 250 == 0) {
+		for (unsigned i = 0; i < 8 && sweet_v2_stats[i].name[0]; i++) {
+			IOLog("SWEET GPU: submits %s: %u (busy %u, failed %u)\n", sweet_v2_stats[i].name,
+			    sweet_v2_stats[i].submits, sweet_v2_stats[i].busy, sweet_v2_stats[i].failed);
+		}
+	}
+	IOLockUnlock(sweet_v2_stat_lock);
+}
