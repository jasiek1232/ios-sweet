 					IOLog("SWEET FB: fence age when the wait began avg %llu us, submit to done avg %llu us, newer submits already queued avg %llu.%02llu\n",
 					    sweet_fb_age_total_ns / 100000, sweet_fb_lat_total_ns / 100000, sweet_fb_behind_total / 100, sweet_fb_behind_total % 100);
