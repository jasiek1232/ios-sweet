--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -133,6 +133,144 @@
 
 OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
 
+/*
+ * 0123: the display engine, read only. miami's panel (NT37701, DSC, command mode) is fed by DPU 6.9 (mainline
+ * catalog/dpu_6_9_sm6375.h; MDSS at 0x5e00000, DPU blocks from 0x5e01000: CTL_0 0x5e02000, SSPP VIG0 0x5e05000 and
+ * DMA0 0x5e25000, INTF_1 0x5e6b800, PINGPONG_0 0x5e71000). The boot left it re-sending the splash memory to the panel
+ * by itself (autorefresh), so copying a frame in while it is being sent tears where the two meet. The tear-check
+ * block's write-pointer line (INTF_TEAR_LINE_COUNT, how far the current transfer has got) says when that is: the copy
+ * (about 3 ms for 2400 rows) is several times faster than a transfer, so a copy started while no transfer is in the
+ * middle of the frame stays ahead of the next one and the panel shows whole frames. sweetfb_race=0 turns it off.
+ * At start the registers are logged and the counters sampled for 40 ms; without a sane, moving line count it stays off.
+ */
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+#define SWEET_DPU_PA            0x05e00000ULL
+#define SWEET_DPU_SIZE          0x90000
+#define SWEET_DPU_CTL0          0x02000
+#define SWEET_DPU_INTF1         0x6b800
+#define SWEET_DPU_PP0           0x71000
+#define INTF_FRAME_COUNT        0x0ac
+#define INTF_LINE_COUNT         0x0b0
+#define INTF_TEAR_CHECK_EN      0x284
+#define INTF_TEAR_SYNC_VSYNC    0x288
+#define INTF_TEAR_SYNC_HEIGHT   0x28c
+#define INTF_TEAR_VSYNC_INIT    0x294
+#define INTF_TEAR_INT_COUNT     0x298
+#define INTF_TEAR_START_POS     0x2a0
+#define INTF_TEAR_LINE_COUNT    0x2b0
+#define INTF_TEAR_AUTOREFRESH   0x2b4
+
+static volatile uint32_t *sweet_dpu;
+static bool sweet_race;
+static uint32_t sweet_race_top, sweet_race_end;	/* safe while the write pointer is at or below top, or at or past end */
+static uint64_t sweet_race_waits, sweet_race_wait_ns, sweet_race_late;
+
+static inline uint32_t
+sweet_dpu_rd(uint32_t off)
+{
+	return sweet_dpu[off / 4];
+}
+
+static void
+sweet_dpu_probe(uint32_t panel_h)
+{
+	uint32_t race = 1;
+	PE_parse_boot_argn("sweetfb_race", &race, sizeof(race));
+	if (!race) {
+		IOLog("SWEET DPU: not read, copies not timed to the panel (sweetfb_race=0)\n");
+		return;
+	}
+	sweet_dpu = (volatile uint32_t *)ml_io_map(SWEET_DPU_PA, SWEET_DPU_SIZE);
+	if (sweet_dpu == NULL) {
+		IOLog("SWEET DPU: map failed\n");
+		return;
+	}
+	IOLog("SWEET DPU: MDSS 0x%08x, DPU top 0x%08x; CTL0 layer0 0x%08x top 0x%08x flush 0x%08x start 0x%08x intf_active 0x%08x fetch_active 0x%08x\n",
+	    sweet_dpu_rd(0x0), sweet_dpu_rd(0x1000), sweet_dpu_rd(SWEET_DPU_CTL0 + 0x00), sweet_dpu_rd(SWEET_DPU_CTL0 + 0x14),
+	    sweet_dpu_rd(SWEET_DPU_CTL0 + 0x18), sweet_dpu_rd(SWEET_DPU_CTL0 + 0x1c), sweet_dpu_rd(SWEET_DPU_CTL0 + 0xf4),
+	    sweet_dpu_rd(SWEET_DPU_CTL0 + 0xfc));
+	uint32_t ib = SWEET_DPU_INTF1;
+	IOLog("SWEET DPU: INTF1 frames 0x%08x lines 0x%08x; tear check en 0x%x vsync 0x%08x height 0x%08x init 0x%08x count 0x%08x start 0x%08x line 0x%08x autorefresh 0x%08x\n",
+	    sweet_dpu_rd(ib + INTF_FRAME_COUNT), sweet_dpu_rd(ib + INTF_LINE_COUNT), sweet_dpu_rd(ib + INTF_TEAR_CHECK_EN),
+	    sweet_dpu_rd(ib + INTF_TEAR_SYNC_VSYNC), sweet_dpu_rd(ib + INTF_TEAR_SYNC_HEIGHT), sweet_dpu_rd(ib + INTF_TEAR_VSYNC_INIT),
+	    sweet_dpu_rd(ib + INTF_TEAR_INT_COUNT), sweet_dpu_rd(ib + INTF_TEAR_START_POS), sweet_dpu_rd(ib + INTF_TEAR_LINE_COUNT),
+	    sweet_dpu_rd(ib + INTF_TEAR_AUTOREFRESH));
+	IOLog("SWEET DPU: PP0 0x00..0x30: %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+	    sweet_dpu_rd(SWEET_DPU_PP0 + 0x00), sweet_dpu_rd(SWEET_DPU_PP0 + 0x04), sweet_dpu_rd(SWEET_DPU_PP0 + 0x08),
+	    sweet_dpu_rd(SWEET_DPU_PP0 + 0x0c), sweet_dpu_rd(SWEET_DPU_PP0 + 0x10), sweet_dpu_rd(SWEET_DPU_PP0 + 0x14),
+	    sweet_dpu_rd(SWEET_DPU_PP0 + 0x18), sweet_dpu_rd(SWEET_DPU_PP0 + 0x1c), sweet_dpu_rd(SWEET_DPU_PP0 + 0x20),
+	    sweet_dpu_rd(SWEET_DPU_PP0 + 0x24), sweet_dpu_rd(SWEET_DPU_PP0 + 0x28), sweet_dpu_rd(SWEET_DPU_PP0 + 0x2c),
+	    sweet_dpu_rd(SWEET_DPU_PP0 + 0x30));
+
+	/* 40 ms of the counters, every 100 us: how fast frames go and what the write-pointer line does between them */
+	uint32_t te0 = sweet_dpu_rd(ib + INTF_TEAR_INT_COUNT) >> 16, fr0 = sweet_dpu_rd(ib + INTF_FRAME_COUNT);
+	uint32_t lmin = 0xffffffffu, lmax = 0, prev = 0xffffffffu, changes = 0, hist[8] = { 0 };
+	uint32_t span = panel_h ? panel_h : 2400;
+	for (int i = 0; i < 400; i++) {
+		uint32_t l = sweet_dpu_rd(ib + INTF_TEAR_LINE_COUNT) & 0xffff;
+		if (l < lmin) {
+			lmin = l;
+		}
+		if (l > lmax) {
+			lmax = l;
+		}
+		if (prev != 0xffffffffu && l != prev) {
+			changes++;
+		}
+		prev = l;
+		uint32_t bkt = l * 8 / (span + span / 8);
+		hist[bkt < 8 ? bkt : 7]++;
+		delay(100);
+	}
+	uint32_t te = ((sweet_dpu_rd(ib + INTF_TEAR_INT_COUNT) >> 16) - te0) & 0xffff;
+	uint32_t fr = sweet_dpu_rd(ib + INTF_FRAME_COUNT) - fr0;
+	IOLog("SWEET DPU: in 40 ms: %u tear-check frames, %u interface frames; write-pointer line %u..%u, changed %u of 400 samples; "
+	    "by eighths of %u: %u %u %u %u %u %u %u %u\n", te, fr, lmin, lmax, changes, span + span / 8,
+	    hist[0], hist[1], hist[2], hist[3], hist[4], hist[5], hist[6], hist[7]);
+	if (race && (te >= 2 || fr >= 2) && changes >= 20 && lmax >= span / 2 && lmax <= span * 2) {
+		sweet_race = true;
+		sweet_race_top = 16;
+		sweet_race_end = lmax > 16 ? lmax - 16 : lmax;
+		IOLog("SWEET DPU: frame copies wait for the write pointer to be at line <= %u or >= %u (sweetfb_race=0 turns this off)\n",
+		    sweet_race_top, sweet_race_end);
+	} else {
+		IOLog("SWEET DPU: copies are not timed to the panel (%s)\n", race ? "counters not usable" : "sweetfb_race=0");
+	}
+	/* last: the source pipes (an unused one could be the one block that does not answer) */
+	static const struct { uint32_t off; const char *name; } pipes[] = { { 0x05000, "VIG0" }, { 0x25000, "DMA0" } };
+	for (unsigned i = 0; i < 2; i++) {
+		uint32_t b = pipes[i].off;
+		IOLog("SWEET DPU: SSPP %s src size 0x%08x xy 0x%08x out size 0x%08x xy 0x%08x addr0 0x%08x stride0 0x%08x format 0x%08x unpack 0x%08x op 0x%08x\n",
+		    pipes[i].name, sweet_dpu_rd(b + 0x00), sweet_dpu_rd(b + 0x08), sweet_dpu_rd(b + 0x0c), sweet_dpu_rd(b + 0x10),
+		    sweet_dpu_rd(b + 0x14), sweet_dpu_rd(b + 0x24), sweet_dpu_rd(b + 0x30), sweet_dpu_rd(b + 0x34), sweet_dpu_rd(b + 0x38));
+	}
+}
+
+/* before a frame copy: wait (at most 20 ms) until no panel transfer is in the middle of the frame */
+static void
+sweet_race_wait(void)
+{
+	if (!sweet_race) {
+		return;
+	}
+	uint64_t t0 = mach_absolute_time(), lim = 0, ns = 0;
+	nanoseconds_to_absolutetime(20 * NSEC_PER_MSEC, &lim);
+	for (;;) {
+		uint32_t l = sweet_dpu_rd(SWEET_DPU_INTF1 + INTF_TEAR_LINE_COUNT) & 0xffff;
+		if (l <= sweet_race_top || l >= sweet_race_end) {
+			break;
+		}
+		if (mach_absolute_time() - t0 > lim) {
+			sweet_race_late++;
+			break;
+		}
+		delay(20);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	sweet_race_waits++;
+	sweet_race_wait_ns += ns;
+}
+
 class IOMobileFramebufferUserClient : public IOUserClient {
 	OSDeclareDefaultStructors(IOMobileFramebufferUserClient);
 
