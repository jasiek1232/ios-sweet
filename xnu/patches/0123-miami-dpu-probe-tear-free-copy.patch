+					}
 					sweet_fb_wait_total_ns = sweet_fb_wait_max_ns = sweet_fb_copy_total_ns = 0;
 					sweet_fb_age_total_ns = sweet_fb_lat_total_ns = sweet_fb_behind_total = 0;
 				}
@@ -526,6 +669,7 @@
 				}
 				__asm__ volatile ("dsb sy" ::: "memory");
 			}
+			sweet_race_wait();
 			uint64_t tc = mach_absolute_time();
 			for (int32_t y = 0; y < h; y++) {
 				memcpy((void *)(fPixels + (uint64_t)(dy + y) * fRowBytes + (uint64_t)dx * 4),
