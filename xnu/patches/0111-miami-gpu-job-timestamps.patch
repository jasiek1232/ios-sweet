+static void
+g_lat_note(uint32_t seq)
+{
+	volatile uint32_t *t = (volatile uint32_t *)((uintptr_t)gp.fence.kva + G_TS_OFF + 16u * (seq & 63));
+	uint64_t st = ((uint64_t)t[1] << 32) | t[0], en = ((uint64_t)t[3] << 32) | t[2];
+	uint64_t now = sweet_gpu_timestamp(), sub = g_sub_gts[seq & 63];
+	if (!st || !en || en < st || st < sub || now < en)
+		return;
+	g_ls_n++;
+	g_ls_q += st - sub;
+	g_ls_x += en - st;
+	if (en - st > g_ls_xmax)
+		g_ls_xmax = en - st;
+	g_ls_late += now - en;
+	if (g_ls_n >= 200) {
+		printf("SWEET GPULAT: %llu jobs: queue before start avg %llu us, GPU execution avg %llu us max %llu us, fence noticed after end avg %llu us\n",
+		    g_ls_n, g_ls_q * 10 / 192 / g_ls_n, g_ls_x * 10 / 192 / g_ls_n, g_ls_xmax * 10 / 192, g_ls_late * 10 / 192 / g_ls_n);
+		g_ls_n = g_ls_q = g_ls_x = g_ls_xmax = g_ls_late = 0;
+	}
+}
