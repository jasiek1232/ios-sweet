+/*
+ * stage 14: load the GPU zap shader (a615_zap, PAS id 13) the way Linux does:
+ *   1. PIL_PAS_INIT_IMAGE: hand TrustZone the metadata (ELF header + program headers + hash/signature
+ *      segments = the .mdt file) in physically contiguous memory; TZ verifies the signature
+ *   2. PIL_PAS_MEM_SETUP: tell TZ where the code will live (reserved region gpu_micro_code@8aa1a000)
+ *   3. copy the one loadable segment (a615_zap.b02, relocatable) to the start of that region
+ *   4. PIL_PAS_AUTH_AND_RESET: TZ authenticates the code and protects the region
+ * Every step prints before the SMC and stops at the first error.
+ */
+#define G_ZAP_PAS	13u
+#define G_ZAP_PA	0x8aa1a000ull
+
+static int
+g_smc5(uint64_t fn, uint64_t arginfo, uint64_t x2, uint64_t x3, uint64_t x4, uint64_t *val)
+{
+	register uint64_t r0 __asm__("x0") = fn;
+	register uint64_t r1 __asm__("x1") = arginfo;
+	register uint64_t r2 __asm__("x2") = x2;
+	register uint64_t r3 __asm__("x3") = x3;
+	register uint64_t r4 __asm__("x4") = x4;
+	register uint64_t r5 __asm__("x5") = 0;
+	register uint64_t r6 __asm__("x6") = 0;
+	__asm__ volatile ("smc #0"
+	    : "+r"(r0), "+r"(r1), "+r"(r2), "+r"(r3), "+r"(r4), "+r"(r5), "+r"(r6)
+	    :
+	    : "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	if (val)
+		*val = r1;
+	return (int)(uint32_t)r0;
+}
+
+static void
+g_zap_load(void)
+{
+	uint64_t val = 0;
+	int rc;
+	vm_offset_t mem = 0;
+
+	if (kmem_alloc_contig(kernel_map, &mem, 2 * PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET GPUF: no memory for the metadata\n");
+		return;
+	}
+	uint64_t pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)mem));
+	memcpy((void *)mem, g_zap_mdt, sizeof(g_zap_mdt));
+	flush_dcache64((addr64_t)pa, (unsigned)(2 * PAGE_SIZE), TRUE);
+	printf("SWEET GPUF: metadata %u bytes at PA 0x%llx\n", (unsigned)sizeof(g_zap_mdt), (unsigned long long)pa);
+	g_wait(300);
+
+	printf("SWEET GPUF: PAS_INIT_IMAGE(13) ...\n");
+	g_wait(300);
+	rc = g_smc5(G_SCM_FN(0x02, 0x01), 0x82, G_ZAP_PAS, pa, 0, &val);
+	printf("SWEET GPUF: PAS_INIT_IMAGE -> ret 0x%x val 0x%llx\n", (unsigned)rc, (unsigned long long)val);
+	g_wait(300);
+	if (rc != 0)
+		return;
+
+	printf("SWEET GPUF: PAS_MEM_SETUP(13, 0x%llx, 0x1000) ...\n", (unsigned long long)G_ZAP_PA);
+	g_wait(300);
+	rc = g_smc5(G_SCM_FN(0x02, 0x02), 0x3, G_ZAP_PAS, G_ZAP_PA, 0x1000, &val);
+	printf("SWEET GPUF: PAS_MEM_SETUP -> ret 0x%x val 0x%llx\n", (unsigned)rc, (unsigned long long)val);
+	g_wait(300);
+	if (rc != 0)
+		return;
+
+	printf("SWEET GPUF: mapping the zap region and copying %u bytes ...\n", (unsigned)sizeof(g_zap_b02));
+	g_wait(300);
+	vm_offset_t zva = ml_io_map((vm_offset_t)G_ZAP_PA, 0x2000);
+	volatile uint32_t *d = (volatile uint32_t *)zva;
+	for (unsigned i = 0; i < sizeof(g_zap_b02); i += 4) {
+		uint32_t w = (uint32_t)g_zap_b02[i] | ((uint32_t)g_zap_b02[i + 1] << 8) |
+		    ((uint32_t)g_zap_b02[i + 2] << 16) | ((uint32_t)g_zap_b02[i + 3] << 24);
+		d[i / 4] = w;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET GPUF: copied, first words 0x%08x 0x%08x\n", d[0], d[1]);
+	g_wait(300);
+
+	printf("SWEET GPUF: PAS_AUTH_AND_RESET(13) ...\n");
+	g_wait(300);
+	rc = g_smc5(G_SCM_FN(0x02, 0x05), 0x1, G_ZAP_PAS, 0, 0, &val);
+	printf("SWEET GPUF: PAS_AUTH_AND_RESET -> ret 0x%x val 0x%llx (%s)\n", (unsigned)rc, (unsigned long long)val,
+	    rc == 0 ? "ZAP SHADER AUTHENTICATED" : "failed");
+	g_wait(300);
+}
