+/*
+ * miami (Motorola Edge 30 Neo, SM6375): Goodix GT9916S touch over the GENI SPI engine.
+ *
+ * Port of ios-sweet's shim/touch.c, which was verified on the phone (it printed live
+ * touch coordinates). Enable with boot-arg sweettouch=2; sweettouch=1 keeps the
+ * Xiaomi GT9896/I2C driver in sweet_touch.c. All work runs on one kernel thread.
+ *
+ * Hardware (live FDT): spi@4a80000 = QUPv3 wrapper 0 serial engine 0, CS0, mode 0.
+ * SPI pins gpio0..3 (function qup00), reset gpio21, irq gpio22 (polled, not used),
+ * iovdd gpio135, avdd gpio136. Protocol: Linux goodix_berlin_{core,spi}.c (BerlinD).
+ * No firmware/config upload. The only IC writes are the 0xAA chip-confirm pattern at
+ * 0x10000 and a zero acknowledging each touch frame, as Linux does.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <kern/processor.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_touch_gt9916_start(void);
+
+#define G_GCC_PA        0x01400000u
+#define G_GCC_SIZE      0x001f0000u
+#define G_TLMM_PA       0x00500000u     /* per-pin registers: 0x500000 + 0x1000 * gpio */
+#define G_TLMM_SIZE     0x00090000u
+#define G_SE_PA         0x04a80000u
+#define G_SE_SIZE       0x00004000u
+
+/* GCC: QUP wrapper 0 clocks */
+#define G_VOTE          0x7900cu        /* bit6 M_AHB, bit7 S_AHB, bit10 S0 */
+#define G_M_AHB_HALT    0x1f004u
+#define G_S_AHB_HALT    0x1f008u
+#define G_S0_HALT       0x1f144u
+#define G_S0_RCG        0x1f148u
+
+/* GENI serial engine */
+#define SE_FORCE_DEFAULT 0x20u
+#define SE_OUTPUT_CTRL  0x24u
+#define SE_CGC_CTRL     0x28u
+#define SE_STATUS       0x40u
+#define SE_M_CLK_CFG    0x48u
+#define SE_IF_DISABLE   0x64u
+#define SE_FW_REV       0x68u
+#define SE_CLK_SEL      0x7cu
+#define SE_SPI_CPHA     0x224u
+#define SE_SPI_LOOPBACK 0x22cu
+#define SE_SPI_CPOL     0x230u
+#define SE_SPI_DEMUXINV 0x24cu
+#define SE_SPI_DEMUXSEL 0x250u
+#define SE_BYTE_GRAN    0x254u
+#define SE_DMA_MODE_EN  0x258u
+#define SE_SPI_TRANSCFG 0x25cu
+#define SE_TX_PACK0     0x260u
+#define SE_TX_PACK1     0x264u
+#define SE_SPI_WORDLEN  0x268u
+#define SE_SPI_TXLEN    0x26cu
+#define SE_SPI_RXLEN    0x270u
+#define SE_SPI_PREPOST  0x274u
+#define SE_SPI_DELAYCNT 0x278u
+#define SE_RX_PACK0     0x284u
+#define SE_RX_PACK1     0x288u
+#define SE_SPI_SLAVEEN  0x2bcu
+#define SE_M_CMD0       0x600u
+#define SE_M_CMD_CTRL   0x604u
+#define SE_M_IRQ_STATUS 0x610u
+#define SE_M_IRQ_EN     0x614u
+#define SE_M_IRQ_CLEAR  0x618u
+#define SE_TX_FIFO      0x700u
+#define SE_RX_FIFO      0x780u
+#define SE_TX_FIFO_ST   0x800u
+#define SE_RX_FIFO_ST   0x804u
+#define SE_RX_WM        0x810u
+#define SE_RX_RFR_WM    0x814u
+#define SE_GSI_EVENT_EN 0xe18u
+#define SE_IRQ_EN       0xe1cu
+#define SE_HW_PARAM_0   0xe24u
+#define SE_DMA_GENCFG   0xe30u
+
+#define M_CMD_DONE      (1u << 0)
+#define M_RX_WM         (1u << 26)
+#define M_RX_LAST       (1u << 27)
+#define M_TX_WM         (1u << 30)
+#define SPI_TX_ONLY     1u
+#define SPI_FULL_DUPLEX 3u
+
+#define G_GPIO_RESET    21u
+#define G_GPIO_IRQ      22u
+#define G_GPIO_IOVDD    135u
+#define G_GPIO_AVDD     136u
+
+#define G_MAX_TOUCH     10u
+#define G_TXRX_MAX      1100u
+
+static struct {
+	vm_offset_t gcc, tlmm, se;
+	unsigned fifo_depth;
+	uint32_t touch_addr;
+	uint32_t active;
+	int x[G_MAX_TOUCH], y[G_MAX_TOUCH];
+	bool started;
+} g;
+static int g_sleep_chan;
+static uint8_t g_tx[G_TXRX_MAX], g_rx[G_TXRX_MAX];
+
+static uint32_t
+g_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+g_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+g_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&g_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- TLMM ---- */
+static void
+g_gpio_cfg(unsigned n, unsigned func, unsigned pull, unsigned drive_ma, bool oe)
+{
+	uint32_t cur = g_rd(g.tlmm, n * 0x1000u);
+	uint32_t v = (pull & 3u) | ((func & 0xfu) << 2) | ((((drive_ma / 2u) - 1u) & 7u) << 6) |
+	    (oe ? (1u << 9) : 0u);
+	if (cur & (1u << 11)) {         /* eGPIO capable: claim it for the application processor */
+		v |= 1u << 12;
+	}
+	g_wr(g.tlmm, n * 0x1000u, v);
+}
+
+static void
+g_gpio_out(unsigned n, unsigned v)
+{
+	g_wr(g.tlmm, n * 0x1000u + 4u, v ? 2u : 0u);
+}
+
+static unsigned
+g_gpio_in(unsigned n)
+{
+	return g_rd(g.tlmm, n * 0x1000u + 4u) & 1u;
+}
+
+/* ---- clocks ---- */
+static bool
+g_clocks_on(void)
+{
+	g_wr(g.gcc, G_VOTE, g_rd(g.gcc, G_VOTE) | (1u << 6) | (1u << 7) | (1u << 10));
+	g_wait(2);
+	if (!(g_rd(g.gcc, G_S0_RCG + 0x14u) & 1u)) {
+		/* not in DFS mode: XO, divider 1 */
+		g_wr(g.gcc, G_S0_RCG + 4u, 1u);
+		g_wr(g.gcc, G_S0_RCG, g_rd(g.gcc, G_S0_RCG) | 1u);
+		for (unsigned i = 0; i < 1000 && (g_rd(g.gcc, G_S0_RCG) & 1u); i++) {
+			delay(10);
+		}
+		g_wr(g.gcc, G_S0_RCG, g_rd(g.gcc, G_S0_RCG) | 2u);
+		g_wait(1);
+	}
+	uint32_t off = g_rd(g.gcc, G_M_AHB_HALT) | g_rd(g.gcc, G_S_AHB_HALT) | g_rd(g.gcc, G_S0_HALT);
+	printf("SWEET TOUCH9916: QUP0 clocks mahb=%#x sahb=%#x s0=%#x\n",
+	    g_rd(g.gcc, G_M_AHB_HALT), g_rd(g.gcc, G_S_AHB_HALT), g_rd(g.gcc, G_S0_HALT));
+	return !(off & (1u << 31));
+}
+
+/* ---- GENI SPI engine ---- */
+static void
+g_config_packing(uint32_t bpw, uint32_t pack_words)
+{
+	uint32_t cfg[4] = {0, 0, 0, 0};
+	int idx_start = (int)bpw - 1, idx = idx_start, temp = (int)bpw;
+	int iter = (int)((((bpw + 7u) & ~7u) * pack_words) / 8u);
+
+	for (int i = 0; i < iter && i < 4; i++) {
+		int len = (temp < 8 ? temp : 8) - 1;
+		cfg[i] = ((uint32_t)idx << 5) | (1u << 4) | ((uint32_t)len << 1);
+		if (temp <= 8) {
+			idx = (i + 1) * 8 + idx_start;
+			temp = (int)bpw;
+		} else {
+			idx -= 8;
+			temp -= 8;
+		}
+	}
+	cfg[iter - 1] |= 1u;
+	uint32_t c0 = cfg[0] | (cfg[1] << 10), c1 = cfg[2] | (cfg[3] << 10);
+	g_wr(g.se, SE_TX_PACK0, c0);
+	g_wr(g.se, SE_TX_PACK1, c1);
+	g_wr(g.se, SE_RX_PACK0, c0);
+	g_wr(g.se, SE_RX_PACK1, c1);
+	g_wr(g.se, SE_BYTE_GRAN, bpw / 16u);
+}
+
+static void
+g_spi_set(unsigned mode, unsigned div)
+{
+	g_wr(g.se, SE_SPI_CPHA, mode & 1u);
+	g_wr(g.se, SE_SPI_CPOL, (mode >> 1) & 1u);
+	g_wr(g.se, SE_M_CLK_CFG, (div << 4) | 1u);
+}
+
+static bool
+g_spi_init(void)
+{
+	uint32_t fw = g_rd(g.se, SE_FW_REV);
+	uint32_t ifd = g_rd(g.se, SE_IF_DISABLE);
+	uint32_t hp0 = g_rd(g.se, SE_HW_PARAM_0);
+
+	printf("SWEET TOUCH9916: SE0 fw=%#x ifdis=%#x hw0=%#x status=%#x\n", fw, ifd, hp0,
+	    g_rd(g.se, SE_STATUS));
+	if (((fw >> 8) & 0xffu) != 1u) {
+		printf("SWEET TOUCH9916: SE0 protocol is not SPI\n");
+		return false;
+	}
+	if (ifd & 1u) {
+		printf("SWEET TOUCH9916: SE0 FIFO interface disabled\n");
+		return false;
+	}
+	g.fifo_depth = (hp0 >> 16) & 0x3fu;
+	if (!g.fifo_depth) {
+		g.fifo_depth = 16;
+	}
+	g_wr(g.se, SE_CGC_CTRL, g_rd(g.se, SE_CGC_CTRL) | 0x7fu);
+	g_wr(g.se, SE_DMA_GENCFG, g_rd(g.se, SE_DMA_GENCFG) | 0xfu);
+	g_wr(g.se, SE_OUTPUT_CTRL, 0x7fu);
+	g_wr(g.se, SE_FORCE_DEFAULT, 1u);
+	g_wr(g.se, SE_IRQ_EN, g_rd(g.se, SE_IRQ_EN) | 0xfu);
+	g_wr(g.se, SE_DMA_MODE_EN, g_rd(g.se, SE_DMA_MODE_EN) & ~1u);
+	g_wr(g.se, SE_GSI_EVENT_EN, 0);
+	g_wr(g.se, SE_RX_WM, g.fifo_depth - 3u);
+	g_wr(g.se, SE_RX_RFR_WM, g.fifo_depth - 2u);
+	g_wr(g.se, SE_M_IRQ_EN, g_rd(g.se, SE_M_IRQ_EN) | 0x7eu | (1u << 22) | (1u << 23) |
+	    (0xfu << 24) | M_CMD_DONE | M_RX_WM | M_RX_LAST | M_TX_WM);
+	g_wr(g.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	g_wr(g.se, SE_SPI_SLAVEEN, 0);
+	g_wr(g.se, SE_SPI_LOOPBACK, 0);
+	g_wr(g.se, SE_SPI_DEMUXSEL, 0);
+	g_wr(g.se, SE_SPI_DEMUXINV, 0);
+	g_wr(g.se, SE_SPI_TRANSCFG, 0);
+	g_wr(g.se, SE_SPI_PREPOST, 0);
+	g_wr(g.se, SE_SPI_DELAYCNT, 0);
+	g_config_packing(8, 4);
+	g_wr(g.se, SE_SPI_WORDLEN, 8u - 4u);
+	g_wr(g.se, SE_CLK_SEL, 0);
+	g_spi_set(0, 4);                /* mode 0, 19.2 MHz / 4 = 4.8 MHz */
+	return true;
+}
+
+static unsigned
+g_drain_rx(unsigned rx_got, unsigned len)
+{
+	for (;;) {
+		uint32_t rs = g_rd(g.se, SE_RX_FIFO_ST);
+		unsigned wc = rs & 0x01ffffffu;
+		if (!wc) {
+			break;
+		}
+		for (unsigned k = 0; k < wc; k++) {
+			uint32_t w = g_rd(g.se, SE_RX_FIFO);
+			unsigned nb = 4;
+			if (k == wc - 1 && (rs & (1u << 31))) {
+				nb = (rs >> 28) & 7u;
+				if (!nb) {
+					nb = 4;
+				}
+			}
+			for (unsigned b = 0; b < nb && rx_got < len; b++) {
+				g_rx[rx_got++] = (uint8_t)((w >> (8 * b)) & 0xffu);
+			}
+		}
+	}
+	return rx_got;
+}
+
+/* One chip-select assertion: len bytes out of g_tx and, if rx, len bytes into g_rx. */
+static int
+g_spi_xfer(unsigned len, bool rx)
+{
+	unsigned tx_words = (len + 3u) / 4u, tx_done = 0, rx_got = 0;
+	unsigned spins = 0;
+
+	g_wr(g.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	g_wr(g.se, SE_SPI_TXLEN, len);
+	if (rx) {
+		g_wr(g.se, SE_SPI_RXLEN, len);
+	}
+	g_wr(g.se, SE_M_CMD0, (rx ? SPI_FULL_DUPLEX : SPI_TX_ONLY) << 27);
+
+	for (;;) {
+		uint32_t st = g_rd(g.se, SE_M_IRQ_STATUS);
+
+		while (tx_done < tx_words) {
+			uint32_t wc = g_rd(g.se, SE_TX_FIFO_ST) & 0x0fffffffu;
+			if (wc >= g.fifo_depth) {
+				break;
+			}
+			uint32_t w = 0;
+			for (unsigned b = 0; b < 4; b++) {
+				unsigned i = tx_done * 4u + b;
+				if (i < len) {
+					w |= (uint32_t)g_tx[i] << (8 * b);
+				}
+			}
+			g_wr(g.se, SE_TX_FIFO, w);
+			tx_done++;
+		}
+		if (rx) {
+			rx_got = g_drain_rx(rx_got, len);
+		}
+		if (st & M_CMD_DONE) {
+			g_wr(g.se, SE_M_IRQ_CLEAR, st);
+			if (rx) {
+				rx_got = g_drain_rx(rx_got, len);
+			}
+			return (rx && rx_got < len) ? EIO : 0;
+		}
+		if (++spins > 60000u) {         /* ~60 ms of 1 us steps */
+			g_wr(g.se, SE_M_CMD_CTRL, 2u);  /* abort */
+			delay(1000);
+			g_wr(g.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+}
+
+/* ---- Goodix Berlin-D over SPI ---- */
+static int
+g_read(uint32_t addr, uint8_t *dst, unsigned n)
+{
+	unsigned len = 8u + n;
+	if (len > G_TXRX_MAX) {
+		return EINVAL;
+	}
+	for (unsigned i = 0; i < len; i++) {
+		g_tx[i] = 0;
+	}
+	g_tx[0] = 0xf1u;
+	g_tx[1] = (uint8_t)(addr >> 24);
+	g_tx[2] = (uint8_t)(addr >> 16);
+	g_tx[3] = (uint8_t)(addr >> 8);
+	g_tx[4] = (uint8_t)addr;
+	int r = g_spi_xfer(len, true);
+	if (r) {
+		return r;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		dst[i] = g_rx[8u + i];
+	}
+	return 0;
+}
+
+static int
+g_write(uint32_t addr, const uint8_t *src, unsigned n)
+{
+	if (5u + n > G_TXRX_MAX) {
+		return EINVAL;
+	}
+	g_tx[0] = 0xf0u;
+	g_tx[1] = (uint8_t)(addr >> 24);
+	g_tx[2] = (uint8_t)(addr >> 16);
+	g_tx[3] = (uint8_t)(addr >> 8);
+	g_tx[4] = (uint8_t)addr;
+	for (unsigned i = 0; i < n; i++) {
+		g_tx[5u + i] = src[i];
+	}
+	return g_spi_xfer(5u + n, false);
+}
+
+static uint32_t
+g_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static unsigned
+g_le16(const uint8_t *p)
+{
+	return (unsigned)p[0] | ((unsigned)p[1] << 8);
+}
+
+static void
+g_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < G_MAX_TOUCH; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(g.active & bit) || x[id] != g.x[id] || y[id] != g.y[id]) {
+				sweet_hid_touch((int)id, 1, x[id], y[id]);
+			}
+			g.x[id] = x[id];
+			g.y[id] = y[id];
+		} else if (g.active & bit) {
+			sweet_hid_touch((int)id, 0, g.x[id], g.y[id]);
+		}
+	}
+	g.active = mask;
+}
+
+static int
+g_poll_touch(void)
+{
+	static uint8_t ev[8u + G_MAX_TOUCH * 8u + 2u];
+	static const uint8_t zero = 0;
+	int err = g_read(g.touch_addr, ev, 8u + 2u * 8u + 2u);
+	if (err) {
+		return err;
+	}
+	if (!(ev[0] & 0x80u)) {
+		if (ev[0] & 0x40u) {
+			static bool warned;
+			if (!warned) {
+				warned = true;
+				printf("SWEET TOUCH9916: chip request event %#x ignored\n", ev[0]);
+			}
+		}
+		return 0;
+	}
+	unsigned n = ev[2] & 0xfu;
+	if (n > G_MAX_TOUCH) {
+		(void)g_write(g.touch_addr, &zero, 1);
+		return EIO;
+	}
+	if (n > 2) {
+		err = g_read(g.touch_addr, ev, 8u + n * 8u + 2u);
+		if (err) {
+			return err;
+		}
+	}
+	int x[G_MAX_TOUCH] = {0}, y[G_MAX_TOUCH] = {0};
+	uint32_t mask = 0;
+	for (unsigned i = 0; i < n; i++) {
+		const uint8_t *p = ev + 8u + i * 8u;
+		unsigned id = p[0] >> 4;
+		if (id >= G_MAX_TOUCH || (mask & (1u << id))) {
+			continue;
+		}
+		/* The panel reports on an 8640 x 19200 grid; the HID layer wants 1080 x 2400. */
+		unsigned px = g_le16(p + 2) / 8u, py = g_le16(p + 4) / 8u;
+		if (px > 1079u) {
+			px = 1079u;
+		}
+		if (py > 2399u) {
+			py = 2399u;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	err = g_write(g.touch_addr, &zero, 1);  /* acknowledge the frame */
+	g_report(mask, x, y);
+	return err;
+}
+
+static bool
+g_chip_up(void)
+{
+	static uint8_t b[1100];
+	static const uint8_t aa[8] = {0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa};
+
+	/* supplies and reset, as in Linux goodix_berlin_power_on */
+	g_gpio_cfg(G_GPIO_RESET, 0, 3, 8, true);
+	g_gpio_out(G_GPIO_RESET, 0);
+	g_gpio_cfg(G_GPIO_IRQ, 0, 3, 8, false);
+	g_gpio_cfg(G_GPIO_IOVDD, 0, 0, 2, true);
+	g_gpio_cfg(G_GPIO_AVDD, 0, 0, 2, true);
+	g_gpio_out(G_GPIO_IOVDD, 1);
+	g_wait(3);
+	g_gpio_out(G_GPIO_AVDD, 1);
+	g_wait(15);
+	g_gpio_out(G_GPIO_RESET, 1);
+	g_wait(250);
+	printf("SWEET TOUCH9916: iovdd=%u avdd=%u rst=%u irq=%u\n", g_gpio_in(G_GPIO_IOVDD),
+	    g_gpio_in(G_GPIO_AVDD), g_gpio_in(G_GPIO_RESET), g_gpio_in(G_GPIO_IRQ));
+
+	/* find an SPI mode/clock the chip answers in (mode 0 at 4.8 MHz did on the test phone) */
+	static const unsigned divs[2] = {4, 16};
+	bool ok = false;
+	for (unsigned m = 0; m < 4 && !ok; m++) {
+		for (unsigned di = 0; di < 2 && !ok; di++) {
+			g_spi_set(m, divs[di]);
+			int w = g_write(0x10000, aa, 8);
+			g_wait(1);
+			int r = g_read(0x10000, b, 8);
+			if (!w && !r && b[0] == 0xaa && b[7] == 0xaa) {
+				ok = true;
+				printf("SWEET TOUCH9916: chip answers in mode %u div %u\n", m, divs[di]);
+			}
+		}
+	}
+	if (!ok) {
+		printf("SWEET TOUCH9916: chip does not answer\n");
+		return false;
+	}
+	g_wait(100);
+
+	if (g_read(0x10070, b, 2)) {
+		return false;
+	}
+	unsigned length = g_le16(b);
+	if (length < 64u || length >= 1024u) {
+		printf("SWEET TOUCH9916: bad IC info length %u\n", length);
+		return false;
+	}
+	if (g_read(0x10070, b, length)) {
+		return false;
+	}
+	unsigned off = 2u + 16u + 10u + 4u;     /* length, version, feature, drv/sen/btn/force */
+	for (unsigned k = 0; k < 5u && off < length; k++) {
+		off += 1u + 2u * b[off];
+	}
+	if (off + 48u <= length) {
+		g.touch_addr = g_le32(&b[off + 44u]);
+	}
+	printf("SWEET TOUCH9916: touch data address %#x\n", g.touch_addr);
+	return g.touch_addr != 0;
+}
+
+static void
+g_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 20;
+	(void)arg;
+	(void)result;
+	/* Start late: if anything below hangs the bus, the GUI and log got there first. */
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET TOUCH9916: starting in %u s\n", delay_s);
+	g_wait(delay_s * 1000u);
+	g.gcc = ml_io_map(G_GCC_PA, G_GCC_SIZE);
+	g.tlmm = ml_io_map(G_TLMM_PA, G_TLMM_SIZE);
+	g.se = ml_io_map(G_SE_PA, G_SE_SIZE);
+	/* SM6375 USB bring-up aid: raw GCC window around USB30_PRIM (read-only). */
+	if (g.gcc) {
+		for (uint32_t o = 0x1a000; o < 0x1a0c0; o += 16) {
+			printf("SWEET GCC[%05x] %08x %08x %08x %08x\n", o,
+			    *(volatile uint32_t *)(g.gcc + o), *(volatile uint32_t *)(g.gcc + o + 4),
+			    *(volatile uint32_t *)(g.gcc + o + 8), *(volatile uint32_t *)(g.gcc + o + 12));
+		}
+	}
+	if (!g.gcc || !g.tlmm || !g.se) {
+		printf("SWEET TOUCH9916: MMIO mapping failed\n");
+		goto out;
+	}
+	if (!g_clocks_on()) {
+		printf("SWEET TOUCH9916: a QUP clock stayed off\n");
+		goto out;
+	}
+	/* SPI pins: gpio0/1 use function 2, gpio2/3 function 1 (qup00) */
+	g_gpio_cfg(0, 2, 0, 8, false);
+	g_gpio_cfg(1, 2, 0, 8, false);
+	g_gpio_cfg(2, 1, 0, 8, false);
+	g_gpio_cfg(3, 1, 0, 8, false);
+	if (!g_spi_init() || !g_chip_up()) {
+		goto out;
+	}
+	printf("SWEET TOUCH9916: running\n");
+	unsigned errs = 0, frames = 0;
+	for (;;) {
+		g_wait(4);
+		int e = g_poll_touch();
+		if (e) {
+			if (++errs <= 5u || (errs % 1000u) == 0u) {
+				printf("SWEET TOUCH9916: read error %d (count %u)\n", e, errs);
+			}
+		} else if (++frames == 1u) {
+			printf("SWEET TOUCH9916: first frame\n");
+		}
+	}
+out:
+	(void)thread_terminate(current_thread());
+}
+
+void
+sweet_touch_gt9916_start(void)
+{
+	thread_t thread;
+	if (g.started) {
+		return;
+	}
+	g.started = true;
+	kern_return_t kr = kernel_thread_start(g_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET TOUCH9916: kernel_thread_start failed %d\n", kr);
+	}
+}
+
+/*
+ * SM6375 USB bring-up aid: never let a USB register access block boot.
+ * Each probe read runs on its own kernel thread; the line printed before the
+ * read tells us which block is unreachable if a thread never prints its result.
+ */
+static void
+g_usbp_thread(void *arg, wait_result_t w)
+{
+	(void)w;
+	uint64_t pa = (uint64_t)(uintptr_t)arg;
+	g_wait(2000);
+	printf("SWEET USBP: map+read PA 0x%llx ...\n", (unsigned long long)pa);
+	vm_offset_t va = ml_io_map((vm_offset_t)(pa & ~0xfffULL), 0x1000);
+	if (va == 0) {
+		printf("SWEET USBP: PA 0x%llx map failed\n", (unsigned long long)pa);
+		goto out;
+	}
+	uint32_t v = *(volatile uint32_t *)(va + (pa & 0xfffULL));
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	printf("SWEET USBP: PA 0x%llx = 0x%08x\n", (unsigned long long)pa, v);
+out:
+	(void)thread_terminate(current_thread());
+}
+
+extern void sweet_usb_start_direct(vm_offset_t dwc);
+
+static void
+g_usbmain_thread(void *arg, wait_result_t w)
+{
+	static const uint32_t regs[] = {
+		0xc110, 0xc118, 0xc200, 0xc140, 0xc700, 0xc704, 0xc708, 0xc70c, 0xc720,
+		0xc400, 0xc404, 0xc408, 0xc40c,
+	};
+	(void)arg;
+	(void)w;
+	g_wait(15000);
+	vm_offset_t va = ml_io_map(0x04e00000, 0xd000);
+	printf("SWEET USBP: DWC3 map %s\n", va ? "ok" : "FAILED");
+	for (unsigned i = 0; va && i < sizeof(regs) / sizeof(regs[0]); i++) {
+		printf("SWEET USBP: reading DWC3+0x%x ...\n", regs[i]);
+		uint32_t v = *(volatile uint32_t *)(va + regs[i]);
+		__asm__ volatile ("dmb oshld" ::: "memory");
+		printf("SWEET USBP: DWC3+0x%x = 0x%08x\n", regs[i], v);
+		g_wait(50);
+	}
+	printf("SWEET USBP: register walk done\n");
+	int mode = 1;
+	PE_parse_boot_argn("sweetusb", &mode, sizeof(mode));
+	if (mode >= 2) {
+		printf("SWEET USBP: starting USB device bring-up (sweetusb=%d)\n", mode);
+		sweet_usb_start_direct(va);
+		printf("SWEET USBP: bring-up call returned\n");
+	}
+	(void)thread_terminate(current_thread());
+}
+
+/* Rough CPU speed: iterations/us of a 1-cycle-per-iteration loop timed with the 19.2 MHz counter. */
+static unsigned
+g_loop_mhz(uint64_t *mpidr_out)
+{
+	uint64_t t0, t1, i = 20000000ULL, best = 0;
+	for (int k = 0; k < 5; k++) {
+		i = 20000000ULL;
+		__asm__ volatile ("isb\n mrs %0, cntvct_el0" : "=r"(t0) :: "memory");
+		__asm__ volatile ("1: subs %0, %0, #1\n b.ne 1b" : "+r"(i) :: "cc");
+		__asm__ volatile ("isb\n mrs %0, cntvct_el0" : "=r"(t1) :: "memory");
+		uint64_t us = ((t1 - t0) * 1000000ULL) / 19200000ULL;
+		uint64_t mhz = us ? (20000000ULL / us) : 0;
+		if (mhz > best) {
+			best = mhz;
+		}
+	}
+	__asm__ volatile ("mrs %0, mpidr_el1" : "=r"(*mpidr_out));
+	return (unsigned)best;
+}
+
+/* defined in osfmk/kern/sched_prim.c, declared only under MACH_KERNEL_PRIVATE */
+extern processor_t thread_bind(processor_t);
+
+static unsigned
+g_loop_mhz_on(int cpu, uint64_t *mpidr_out)
+{
+	unsigned mhz;
+	thread_bind(cpu_to_processor(cpu));
+	thread_block(THREAD_CONTINUE_NULL);
+	mhz = g_loop_mhz(mpidr_out);
+	thread_bind(PROCESSOR_NULL);
+	return mhz;
+}
+
+static void
+g_bench_all(const char *tag)
+{
+	static const int cpus[] = { 0, 3, 5, 6, 7 };
+	for (unsigned i = 0; i < sizeof(cpus) / sizeof(cpus[0]); i++) {
+		uint64_t mp = 0;
+		unsigned mhz = g_loop_mhz_on(cpus[i], &mp);
+		printf("SWEET CPUF: %s cpu%d (mpidr 0x%llx) ~%u MHz\n", tag, cpus[i],
+		    (unsigned long long)(mp & 0xff00), mhz);
+	}
+}
+
+/*
+ * EPSS cpufreq-hw (qcom,cpufreq-hw-epss): per cluster a LUT at +0x100 (freq =
+ * (entry & 0xff) * 19.2 MHz), and the requested LUT index at +0x320. Nothing
+ * else ever writes it here, so the clusters sit wherever ABL left them (A55 at
+ * step 6 of 9 = 1517 MHz, A76 at step 0 = 691 MHz). Boot-arg sweetcpuf:
+ * 0 = leave alone, 1 (default) = top step, N>=2 = step N-2.
+ */
+static void
+g_cpufreq_thread(void *arg, wait_result_t w)
+{
+	int mode = 1;
+	vm_offset_t dom[2] = { 0, 0 };
+	(void)arg;
+	(void)w;
+	PE_parse_boot_argn("sweetcpuf", &mode, sizeof(mode));
+	g_wait(4000);
+	for (int d = 0; d < 2; d++) {
+		uint64_t pa = d ? 0x0fd92000ULL : 0x0fd91000ULL;
+		dom[d] = ml_io_map((vm_offset_t)pa, 0x1000);
+	}
+	g_bench_all("before");
+	for (int d = 0; d < 2 && mode != 0; d++) {
+		if (!dom[d]) {
+			continue;
+		}
+		uint32_t top = 0;
+		while (top < 11 && (*(volatile uint32_t *)(dom[d] + 0x100 + 4 * (top + 1)) & 0xff) >
+		    (*(volatile uint32_t *)(dom[d] + 0x100 + 4 * top) & 0xff)) {
+			top++;
+		}
+		uint32_t want = (mode == 1) ? top : (uint32_t)(mode - 2);
+		if (want > top) {
+			want = top;
+		}
+		uint32_t was = *(volatile uint32_t *)(dom[d] + 0x320);
+		*(volatile uint32_t *)(dom[d] + 0x320) = want;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		g_wait(100);
+		printf("SWEET CPUF: domain %d step %u -> %u (top %u, now reads %u, ~%u MHz)\n", d, was, want, top,
+		    *(volatile uint32_t *)(dom[d] + 0x320),
+		    (*(volatile uint32_t *)(dom[d] + 0x100 + 4 * want) & 0xff) * 192 / 10);
+	}
+	g_wait(500);
+	g_bench_all("after");
+	g_wait(20000);
+	g_bench_all("later");
+	for (int d = 0; d < 2; d++) {
+		if (dom[d]) {
+			printf("SWEET CPUF: domain %d perf-state reg now %u\n", d, *(volatile uint32_t *)(dom[d] + 0x320));
+		}
+	}
+	printf("SWEET CPUF: done\n");
+	(void)thread_terminate(current_thread());
+}
+
+/*
+ * sweetgpuprobe=1: walk the Adreno 619 blocks one register at a time, safest first, a pause
+ * between reads so the log (USB live 100 ms, userdata ring ~1 s) has flushed the line
+ * printed before the read. The last "reading" line without a result names the culprit.
+ */
+static void
+g_gpuwalk_thread(void *arg, wait_result_t w)
+{
+	static const struct { uint64_t pa; const char *name; } regs[] = {
+		{ 0x0599106cULL, "GPUCC CX_GDSCR" }, { 0x0599100cULL, "GPUCC GX_GDSCR" },
+		{ 0x05990000ULL, "GPUCC +0x0" }, { 0x05991078ULL, "GPUCC +0x1078" },
+		{ 0x05991098ULL, "GPUCC +0x1098" }, { 0x0599109cULL, "GPUCC +0x109c" },
+		{ 0x05940000ULL, "KGSL-SMMU sCR0" }, { 0x05940020ULL, "KGSL-SMMU IDR0" },
+		{ 0x0599e000ULL, "cx_misc +0" }, { 0x05961000ULL, "cx_dbgc +0" },
+		{ 0x0596a000ULL, "gmu_wrapper +0" }, { 0x05900840ULL, "GPU RBBM_STATUS" },
+	};
+	(void)arg;
+	(void)w;
+	g_wait(20000);
+	printf("SWEET GPUW: walk start\n");
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		printf("SWEET GPUW: reading %s PA 0x%llx ...\n", regs[i].name, (unsigned long long)regs[i].pa);
+		g_wait(1500);
+		vm_offset_t va = ml_io_map((vm_offset_t)(regs[i].pa & ~0xfffULL), 0x1000);
+		if (!va) {
+			printf("SWEET GPUW: map failed\n");
+			continue;
+		}
+		uint32_t v = *(volatile uint32_t *)(va + (regs[i].pa & 0xfffULL));
+		__asm__ volatile ("dmb oshld" ::: "memory");
+		printf("SWEET GPUW: %s = 0x%08x\n", regs[i].name, v);
+		g_wait(1500);
+	}
+	printf("SWEET GPUW: walk done\n");
+	(void)thread_terminate(current_thread());
+}
+
+/*
+ * sweetgpuprobe=2: first power-up attempt. Clear SW_COLLAPSE on the GPU CX GDSC, then on GX,
+ * reading back each GDSCR (bit31 = PWR_ON). The GPU registers are only read when both domains
+ * report on; otherwise the thread stops with the GDSC status so nothing touches unpowered logic.
+ */
+static vm_offset_t
+g_gpu_map(uint64_t pa)
+{
+	return ml_io_map((vm_offset_t)(pa & ~0xfffULL), 0x1000) + (vm_offset_t)(pa & 0xfffULL);
+}
+
+static int
+g_gdsc_on(const char *name, uint64_t pa)
+{
+	vm_offset_t va = g_gpu_map(pa);
+	if (!va) {
+		printf("SWEET GPUUP: %s map failed\n", name);
+		return 0;
+	}
+	uint32_t v = *(volatile uint32_t *)va;
+	printf("SWEET GPUUP: %s GDSCR before = 0x%08x\n", name, v);
+	g_wait(1500);
+	printf("SWEET GPUUP: %s clearing SW_COLLAPSE ...\n", name);
+	g_wait(1500);
+	*(volatile uint32_t *)va = v & ~1u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int i = 0; i < 20; i++) {
+		g_wait(10);
+		v = *(volatile uint32_t *)va;
+		if (v & 0x80000000u) {
+			break;
+		}
+	}
+	printf("SWEET GPUUP: %s GDSCR after = 0x%08x (%s)\n", name, v, (v & 0x80000000u) ? "ON" : "still OFF");
+	g_wait(1500);
+	return (v & 0x80000000u) != 0;
+}
+
+static void
+g_gpuup_thread(void *arg, wait_result_t w)
+{
+	(void)arg;
+	(void)w;
+	g_wait(20000);
+	printf("SWEET GPUUP: start\n");
+	if (g_gdsc_on("CX", 0x0599106cULL) && g_gdsc_on("GX", 0x0599100cULL)) {
+		static const struct { uint64_t pa; const char *name; } regs[] = {
+			{ 0x05900840ULL, "GPU RBBM_STATUS" }, { 0x05900804ULL, "GPU RBBM_INT_0_STATUS" },
+			{ 0x05991078ULL, "GPUCC +0x1078" }, { 0x05991098ULL, "GPUCC +0x1098" },
+		};
+		for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+			printf("SWEET GPUUP: reading %s PA 0x%llx ...\n", regs[i].name, (unsigned long long)regs[i].pa);
+			g_wait(1500);
+			vm_offset_t va = g_gpu_map(regs[i].pa);
+			uint32_t v = va ? *(volatile uint32_t *)va : 0xdeadbeef;
+			__asm__ volatile ("dmb oshld" ::: "memory");
+			printf("SWEET GPUUP: %s = 0x%08x\n", regs[i].name, v);
+			g_wait(1500);
+		}
+	} else {
+		printf("SWEET GPUUP: power domain did not come on, not touching GPU registers\n");
+	}
+	printf("SWEET GPUUP: done\n");
+	(void)thread_terminate(current_thread());
+}
+
+/*
+ * sweetgpuprobe=3: CX on, read the CX-domain blocks, then look at the PM6125 regulators through
+ * the SPMI arbiter (read-only) to find the GX supply (pm6125_s8, RPM resource rwgx).
+ */
+static uint32_t
+g_mrd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static int
+g_spmi_rd(vm_offset_t obs, uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	uint32_t off = 0x80u * apid;
+	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(obs + off) = cmd;
+	__asm__ volatile ("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 200; i++) {
+		uint32_t st = g_mrd(obs, off + 0x08u);
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				return 0;
+			}
+			*out = (uint8_t)g_mrd(obs, off + 0x18u);
+			return 1;
+		}
+		g_wait(1);
+	}
+	return 0;
+}
+
+/*
+ * sweetgpuprobe=6: full GX power-up as in mainline gpucc-sm6375/gdsc.c: pulse the GX block
+ * resets, pulse the AON reset and drop the IO clamp, then clear SW_COLLAPSE and poll PWR_ON.
+ * Only the GPUCC registers are touched, never the GPU core itself.
+ */
+static void
+g_w32(const char *what, vm_offset_t va, uint32_t val)
+{
+	printf("SWEET GPUX: write %s <- 0x%08x ...\n", what, val);
+	g_wait(200);
+	*(volatile uint32_t *)va = val;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	(void)*(volatile uint32_t *)va;
+}
+
+static int
+g_gx_sequence(void)
+{
+	vm_offset_t cc = g_gpu_map(0x05991000ULL) - 0;
+	vm_offset_t cc8 = g_gpu_map(0x05998000ULL);
+	if (!cc || !cc8) {
+		printf("SWEET GPUX: map failed\n");
+		return 0;
+	}
+	volatile uint32_t *gdscr = (volatile uint32_t *)(cc + 0x00c);
+	volatile uint32_t *cfg = (volatile uint32_t *)(cc + 0x010);
+	volatile uint32_t *bcr_gx = (volatile uint32_t *)(cc + 0x008);
+	volatile uint32_t *bcr_acd = (volatile uint32_t *)(cc + 0x160);
+	volatile uint32_t *bcr_misc = (volatile uint32_t *)(cc8 + 0x004);
+	volatile uint32_t *clamp = (volatile uint32_t *)(cc + 0x508);
+	printf("SWEET GPUX: start GDSCR 0x%08x CFG 0x%08x BCR 0x%08x/0x%08x/0x%08x clamp 0x%08x\n",
+	    *gdscr, *cfg, *bcr_gx, *bcr_acd, *bcr_misc, *clamp);
+	g_wait(1000);
+	/* back to a clean collapsed state first */
+	g_w32("GX GDSCR collapse", (vm_offset_t)gdscr, *gdscr | 1u);
+	g_wait(100);
+	printf("SWEET GPUX: GDSCR now 0x%08x CFG 0x%08x\n", *gdscr, *cfg);
+	g_wait(500);
+	/* assert resets */
+	g_w32("GX_BCR assert", (vm_offset_t)bcr_gx, *bcr_gx | 1u);
+	g_w32("ACD_BCR assert", (vm_offset_t)bcr_acd, *bcr_acd | 1u);
+	g_w32("GX_ACD_MISC_BCR assert", (vm_offset_t)bcr_misc, *bcr_misc | 1u);
+	g_wait(10);
+	g_w32("GX_BCR deassert", (vm_offset_t)bcr_gx, *bcr_gx & ~1u);
+	g_w32("ACD_BCR deassert", (vm_offset_t)bcr_acd, *bcr_acd & ~1u);
+	g_w32("GX_ACD_MISC_BCR deassert", (vm_offset_t)bcr_misc, *bcr_misc & ~1u);
+	g_wait(500);
+	/* AON reset pulse (bit 4), then release the IO clamp (bit 0) */
+	g_w32("clamp_io AON reset", (vm_offset_t)clamp, *clamp | 0x10u);
+	g_wait(5);
+	g_w32("clamp_io AON reset off", (vm_offset_t)clamp, *clamp & ~0x10u);
+	g_w32("clamp_io release", (vm_offset_t)clamp, *clamp & ~1u);
+	g_wait(500);
+	printf("SWEET GPUX: clamp ctrl now 0x%08x\n", *clamp);
+	g_wait(500);
+	g_w32("GX GDSCR enable", (vm_offset_t)gdscr, *gdscr & ~1u);
+	uint32_t v = 0;
+	for (int i = 0; i < 50; i++) {
+		g_wait(10);
+		v = *gdscr;
+		if (v & 0x80000000u) {
+			break;
+		}
+	}
+	printf("SWEET GPUX: GX GDSCR = 0x%08x CFG 0x%08x (%s)\n", v, *cfg, (v & 0x80000000u) ? "ON" : "still OFF");
+	g_wait(1500);
+	printf("SWEET GPUX: later GDSCR 0x%08x CFG 0x%08x\n", *gdscr, *cfg);
+	g_wait(500);
+	return (*gdscr & 0x80000000u) != 0;
+}
+
+/* stage 7: GX is on; look at the GPUCC clock gates (read-only) then at the GPU core */
+static void
+g_gpu_core_probe(void)
+{
+	static const struct { uint64_t pa; const char *name; } cbcr[] = {
+		{ 0x05991078ULL, "AHB_CBCR" }, { 0x059910a4ULL, "CX_GFX3D" }, { 0x059910a8ULL, "CX_GFX3D_SLV" },
+		{ 0x05991098ULL, "CX_GMU" }, { 0x0599108cULL, "CX_SNOC_DVM" }, { 0x05991004ULL, "CXO_AON" },
+		{ 0x0599109cULL, "CXO" }, { 0x05991060ULL, "GX_CXO" }, { 0x05991054ULL, "GX_GFX3D" },
+		{ 0x0599101cULL, "GX_GFX3D_CLK_SRC cmd" },
+	};
+	for (unsigned i = 0; i < sizeof(cbcr) / sizeof(cbcr[0]); i++) {
+		vm_offset_t va = g_gpu_map(cbcr[i].pa);
+		printf("SWEET GPUC: reading %s PA 0x%llx ...\n", cbcr[i].name, (unsigned long long)cbcr[i].pa);
+		g_wait(200);
+		uint32_t v = va ? *(volatile uint32_t *)va : 0xdeadbeef;
+		printf("SWEET GPUC: %s = 0x%08x\n", cbcr[i].name, v);
+		g_wait(200);
+	}
+	static const struct { uint64_t pa; const char *name; } core[] = {
+		{ 0x05900840ULL, "RBBM_STATUS" }, { 0x05900804ULL, "RBBM_INT_0_STATUS" },
+	};
+	for (unsigned i = 0; i < sizeof(core) / sizeof(core[0]); i++) {
+		vm_offset_t va = g_gpu_map(core[i].pa);
+		printf("SWEET GPUC: reading GPU %s PA 0x%llx ...\n", core[i].name, (unsigned long long)core[i].pa);
+		g_wait(1500);
+		uint32_t v = va ? *(volatile uint32_t *)va : 0xdeadbeef;
+		__asm__ volatile ("dmb oshld" ::: "memory");
+		printf("SWEET GPUC: GPU %s = 0x%08x\n", core[i].name, v);
+		g_wait(1500);
+	}
+}
+
+/* stage 8: GPU PLL / clock-source dump (read-only) and a read/write test on CP_RB_BASE */
+static void
+g_gpu_rw_probe(void)
+{
+	static const struct { uint64_t pa; const char *name; } pll[] = {
+		{ 0x05990000ULL, "PLL0 MODE" }, { 0x05990004ULL, "PLL0 L_VAL" }, { 0x0599000cULL, "PLL0 USER_CTL" },
+		{ 0x05990010ULL, "PLL0 USER_CTL_U" }, { 0x05990038ULL, "PLL0 OPMODE" }, { 0x0599003cULL, "PLL0 STATUS" },
+		{ 0x05990040ULL, "PLL0 ALPHA" }, { 0x05990100ULL, "PLL1 MODE" }, { 0x05990104ULL, "PLL1 L_VAL" },
+		{ 0x0599010cULL, "PLL1 USER_CTL" }, { 0x05990138ULL, "PLL1 OPMODE" }, { 0x0599013cULL, "PLL1 STATUS" },
+		{ 0x0599101cULL, "GX_GFX3D_SRC CMD" }, { 0x05991020ULL, "GX_GFX3D_SRC CFG" },
+		{ 0x05991120ULL, "GMU_SRC CMD" }, { 0x05991124ULL, "GMU_SRC CFG" },
+	};
+	for (unsigned i = 0; i < sizeof(pll) / sizeof(pll[0]); i++) {
+		vm_offset_t va = g_gpu_map(pll[i].pa);
+		printf("SWEET GPUR: reading %s PA 0x%llx ...\n", pll[i].name, (unsigned long long)pll[i].pa);
+		g_wait(200);
+		uint32_t v = va ? *(volatile uint32_t *)va : 0xdeadbeef;
+		printf("SWEET GPUR: %s = 0x%08x\n", pll[i].name, v);
+		g_wait(150);
+	}
+	vm_offset_t va = g_gpu_map(0x05902000ULL); /* A6XX_CP_RB_BASE */
+	printf("SWEET GPUR: reading CP_RB_BASE ...\n");
+	g_wait(1500);
+	uint32_t old = *(volatile uint32_t *)va;
+	printf("SWEET GPUR: CP_RB_BASE = 0x%08x, writing test pattern 0x12345678 ...\n", old);
+	g_wait(1500);
+	*(volatile uint32_t *)va = 0x12345678u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t now = *(volatile uint32_t *)va;
+	printf("SWEET GPUR: CP_RB_BASE readback = 0x%08x (%s)\n", now,
+	    (now & ~0x1fu) == 0x12345660u ? "REGISTERS LIVE (low 5 bits are alignment-masked)" : (now == 0 ? "no effect" : "changed, unexpected"));
+	g_wait(1000);
+	*(volatile uint32_t *)va = old;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET GPUR: CP_RB_BASE restored to 0x%08x\n", *(volatile uint32_t *)va);
+	g_wait(500);
+}
+
+/*
+ * stage 9: bring up the GPU clock tree as mainline gpucc-sm6375 does: PLL0 (Lucid, L=0x1b
+ * alpha=0xb555 -> ~532 MHz), GX_GFX3D RCG (src PLL0, /2 -> 266 MHz), then the clock gates.
+ * Every write is announced first; the sequence stops at the first thing that doesn't lock.
+ */
+static void
+g_pw(const char *what, volatile uint32_t *reg, uint32_t val)
+{
+	printf("SWEET GPUK: %s <- 0x%08x\n", what, val);
+	g_wait(120);
+	*reg = val;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static int
+g_gpu_clock_up(void)
+{
+	vm_offset_t p = g_gpu_map(0x05990000ULL);
+	vm_offset_t c = g_gpu_map(0x05991000ULL);
+	if (!p || !c) {
+		printf("SWEET GPUK: map failed\n");
+		return 0;
+	}
+	volatile uint32_t *mode = (volatile uint32_t *)(p + 0x00);
+	volatile uint32_t *r = (volatile uint32_t *)p;
+	printf("SWEET GPUK: PLL0 MODE 0x%08x STATUS 0x%08x\n", *mode, r[0x30 / 4]);
+	g_wait(200);
+	g_pw("PLL0 L_VAL", &r[0x04 / 4], 0x1b);
+	g_pw("PLL0 CAL_L_VAL", &r[0x08 / 4], 0x44);
+	g_pw("PLL0 ALPHA", &r[0x40 / 4], 0xb555);
+	g_pw("PLL0 CONFIG_CTL", &r[0x18 / 4], 0x20485699);
+	g_pw("PLL0 CONFIG_CTL_U", &r[0x1c / 4], 0x00002261);
+	g_pw("PLL0 CONFIG_CTL_U1", &r[0x20 / 4], 0x329a299c);
+	g_pw("PLL0 USER_CTL", &r[0x0c / 4], 0x00000001);
+	g_pw("PLL0 USER_CTL_U", &r[0x10 / 4], 0x00000805);
+	g_pw("PLL0 USER_CTL_U1", &r[0x14 / 4], 0x00000000);
+	g_pw("PLL0 MODE update-bypass", mode, *mode | (1u << 23));
+	g_pw("PLL0 MODE outctrl off", mode, *mode & ~1u);
+	g_pw("PLL0 OPMODE standby", &r[0x38 / 4], 0);
+	g_pw("PLL0 MODE reset_n", mode, *mode | (1u << 2));
+	g_wait(20);
+	printf("SWEET GPUK: PLL0 MODE 0x%08x STATUS 0x%08x (calibration bit27 %s)\n", *mode, r[0x30 / 4],
+	    (r[0x30 / 4] & (1u << 27)) ? "done" : "not done");
+	g_wait(200);
+	g_pw("PLL0 OPMODE run", &r[0x38 / 4], 1);
+	uint32_t m = 0;
+	for (int i = 0; i < 100; i++) {
+		g_wait(1);
+		m = *mode;
+		if (m & 0x80000000u) {
+			break;
+		}
+	}
+	printf("SWEET GPUK: PLL0 MODE 0x%08x STATUS 0x%08x -> %s\n", m, r[0x30 / 4], (m & 0x80000000u) ? "LOCKED" : "NO LOCK");
+	g_wait(200);
+	if (!(m & 0x80000000u)) {
+		g_pw("PLL0 OPMODE standby (abort)", &r[0x38 / 4], 0);
+		return 0;
+	}
+	g_pw("PLL0 USER_CTL outputs", &r[0x0c / 4], r[0x0c / 4] | 7u);
+	g_pw("PLL0 MODE outctrl on", mode, *mode | 1u);
+	g_wait(50);
+	volatile uint32_t *cc = (volatile uint32_t *)c;
+	/* GX_GFX3D RCG: source select 1 (PLL0), pre-div 2 -> hid_div field 3 */
+	g_pw("GX_GFX3D_SRC CFG", &cc[0x20 / 4], (1u << 8) | 3u);
+	g_pw("GX_GFX3D_SRC CMD update", &cc[0x1c / 4], cc[0x1c / 4] | 1u);
+	uint32_t cmd = 0;
+	for (int i = 0; i < 100; i++) {
+		g_wait(1);
+		cmd = cc[0x1c / 4];
+		if (!(cmd & 1u)) {
+			break;
+		}
+	}
+	printf("SWEET GPUK: GX_GFX3D_SRC CMD 0x%08x (%s)\n", cmd, (cmd & 1u) ? "update STUCK" : "updated");
+	g_wait(200);
+	if (cmd & 1u) {
+		return 0;
+	}
+	g_pw("GX_GFX3D_SRC CMD root_en", &cc[0x1c / 4], cc[0x1c / 4] | 2u);
+	g_wait(20);
+	printf("SWEET GPUK: GX_GFX3D_SRC CMD 0x%08x CFG 0x%08x\n", cc[0x1c / 4], cc[0x20 / 4]);
+	g_wait(200);
+	g_pw("GX_GFX3D CBCR enable", &cc[0x54 / 4], cc[0x54 / 4] | 1u);
+	g_wait(20);
+	printf("SWEET GPUK: GX_GFX3D CBCR 0x%08x\n", cc[0x54 / 4]);
+	g_wait(200);
+	g_pw("CX_GFX3D CBCR enable", &cc[0xa4 / 4], cc[0xa4 / 4] | 1u);
+	g_pw("CX_GFX3D_SLV CBCR enable", &cc[0xa8 / 4], cc[0xa8 / 4] | 1u);
+	g_wait(20);
+	printf("SWEET GPUK: CX_GFX3D 0x%08x CX_GFX3D_SLV 0x%08x GX_GFX3D 0x%08x\n", cc[0xa4 / 4], cc[0xa8 / 4], cc[0x54 / 4]);
+	g_wait(300);
+	return 1;
+}
+
+/*
+ * stage 10: read-only dump of the GPU (kgsl) SMMU: global registers, stream matching and
+ * context bank 0. Prints each register name before the read.
+ */
+static uint32_t
+g_smmu_rd(const char *name, uint64_t pa)
+{
+	vm_offset_t va = g_gpu_map(pa);
+	printf("SWEET GPUM: reading %s PA 0x%llx ...\n", name, (unsigned long long)pa);
+	g_wait(100);
+	uint32_t v = va ? *(volatile uint32_t *)va : 0xdeadbeef;
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	printf("SWEET GPUM: %s = 0x%08x\n", name, v);
+	g_wait(100);
+	return v;
+}
+
+static void
+g_smmu_dump(void)
+{
+	const uint64_t base = 0x05940000ULL;
+	uint32_t idr0 = g_smmu_rd("IDR0", base + 0x20);
+	uint32_t idr1 = g_smmu_rd("IDR1", base + 0x24);
+	(void)g_smmu_rd("IDR2", base + 0x28);
+	(void)g_smmu_rd("sCR0", base + 0x00);
+	(void)g_smmu_rd("sCR1", base + 0x04);
+	(void)g_smmu_rd("sCR2", base + 0x08);
+	(void)g_smmu_rd("sACR", base + 0x10);
+	(void)g_smmu_rd("sGFSR", base + 0x48);
+	(void)g_smmu_rd("sGFSYNR0", base + 0x50);
+	uint32_t nsmr = idr0 & 0xffu;
+	uint32_t ncb = idr1 & 0xffu;
+	printf("SWEET GPUM: IDR0 NUMSMRG=%u IDR1 NUMCB=%u NUMPAGENDXB=%u PAGESIZE=%s\n", nsmr, ncb,
+	    (idr1 >> 28) & 7u, (idr1 & 0x80000000u) ? "64K" : "4K");
+	g_wait(300);
+	if (nsmr > 8) {
+		nsmr = 8;
+	}
+	for (uint32_t i = 0; i < nsmr; i++) {
+		char nm[16];
+		snprintf(nm, sizeof(nm), "SMR%u", i);
+		(void)g_smmu_rd(nm, base + 0x800 + 4u * i);
+		snprintf(nm, sizeof(nm), "S2CR%u", i);
+		(void)g_smmu_rd(nm, base + 0xc00 + 4u * i);
+	}
+	/* context banks start in the upper half of the SMMU register space */
+	uint32_t pgsz = (idr1 & 0x80000000u) ? 0x10000u : 0x1000u;
+	uint32_t numpage = 1u << (((idr1 >> 28) & 7u) + 1u);
+	uint64_t cb = base + (uint64_t)numpage * pgsz / 2u;
+	printf("SWEET GPUM: context bank 0 assumed at PA 0x%llx\n", (unsigned long long)cb);
+	g_wait(300);
+	(void)g_smmu_rd("CB0 SCTLR", cb + 0x00);
+	(void)g_smmu_rd("CB0 ACTLR", cb + 0x04);
+	(void)g_smmu_rd("CB0 TTBR0 lo", cb + 0x20);
+	(void)g_smmu_rd("CB0 TTBR0 hi", cb + 0x24);
+	(void)g_smmu_rd("CB0 TCR", cb + 0x30);
+	(void)g_smmu_rd("CB0 MAIR0", cb + 0x38);
+	(void)g_smmu_rd("CB0 FSR", cb + 0x58);
+}
+
+/*
+ * stage 11: program the GPU SMMU like the arm-smmu driver would (stream id 0 -> context bank 0,
+ * stage 1, AArch64 3-level 4K tables, 39-bit IOVA) and check it from the CPU with the SMMU's own
+ * address-translation op (ATS1PR): IOVA 0x5000 must come back as the physical page we mapped.
+ * No GPU traffic is involved. Context banks start at base + 0x8000 (half of the 64 KiB window).
+ */
+static void
+g_smmu_wr(const char *name, uint64_t pa, uint32_t val)
+{
+	vm_offset_t va = g_gpu_map(pa);
+	printf("SWEET GPUT: write %s PA 0x%llx <- 0x%08x ...\n", name, (unsigned long long)pa, val);
+	g_wait(150);
+	*(volatile uint32_t *)va = val;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t back = *(volatile uint32_t *)va;
+	printf("SWEET GPUT: %s reads back 0x%08x\n", name, back);
+	g_wait(150);
+}
+
+static uint32_t
+g_smmu_r(const char *name, uint64_t pa)
+{
+	vm_offset_t va = g_gpu_map(pa);
+	printf("SWEET GPUT: reading %s PA 0x%llx ...\n", name, (unsigned long long)pa);
+	g_wait(120);
+	uint32_t v = *(volatile uint32_t *)va;
+	printf("SWEET GPUT: %s = 0x%08x\n", name, v);
+	g_wait(120);
+	return v;
+}
+
+static void
+g_smmu_setup_test(void)
+{
+	const uint64_t base = 0x05940000ULL;
+	const uint64_t cb = base + 0x8000ULL;
+	/* what is really in the context bank window and the CBAR/CBA2R pages */
+	(void)g_smmu_r("CB0 SCTLR", cb + 0x00);
+	(void)g_smmu_r("CB0 TCR", cb + 0x30);
+	(void)g_smmu_r("GR1 CBAR0", base + 0x1000);
+	(void)g_smmu_r("GR1 CBA2R0", base + 0x1800);
+
+	vm_offset_t mem = 0;
+	if (kmem_alloc_contig(kernel_map, &mem, 4 * PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET GPUT: no memory for page tables\n");
+		return;
+	}
+	uint64_t pa0 = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)mem));
+	/* 4 KiB tables, 4 KiB apart, in one physically contiguous block (the kernel page may be 16 KiB) */
+	uint64_t t1 = pa0, t2 = pa0 + 0x1000, t3 = pa0 + 0x2000, td = pa0 + 0x3000;
+	volatile uint64_t *l1 = (volatile uint64_t *)mem;
+	volatile uint64_t *l2 = (volatile uint64_t *)(mem + 0x1000);
+	volatile uint64_t *l3 = (volatile uint64_t *)(mem + 0x2000);
+	volatile uint32_t *data = (volatile uint32_t *)(mem + 0x3000);
+	printf("SWEET GPUT: tables PA l1 0x%llx l2 0x%llx l3 0x%llx data 0x%llx (PAGE_SIZE %u)\n",
+	    (unsigned long long)t1, (unsigned long long)t2, (unsigned long long)t3,
+	    (unsigned long long)td, (unsigned)PAGE_SIZE);
+	g_wait(300);
+	l1[0] = t2 | 3u;                        /* table */
+	l2[0] = t3 | 3u;                        /* table */
+	l3[5] = td | 0x743u;                    /* page: AF, inner shareable, AP RW, attr 0, valid */
+	data[0] = 0xcafef00du;
+	flush_dcache64((addr64_t)pa0, 0x4000, TRUE);
+	printf("SWEET GPUT: tables built, IOVA 0x5000 -> PA 0x%llx\n", (unsigned long long)td);
+	g_wait(300);
+
+	g_smmu_wr("SMR0", base + 0x800, 0x80000000u);                 /* valid, id 0, mask 0 */
+	g_smmu_wr("S2CR0", base + 0xc00, 0x00000000u);                /* translate via context bank 0 */
+	g_smmu_wr("CBA2R0", base + 0x1800, 0x00000001u);              /* AArch64 */
+	g_smmu_wr("CBAR0", base + 0x1000, (1u << 16) | (0xfu << 12) | (3u << 8)); /* stage 1, stage 2 bypass */
+	g_smmu_wr("CB0 TTBR0 lo", cb + 0x20, (uint32_t)t1);
+	g_smmu_wr("CB0 TTBR0 hi", cb + 0x24, (uint32_t)((t1 >> 32) | (1u << 16)));  /* ASID 1 */
+	g_smmu_wr("CB0 TCR2", cb + 0x10, 0x2u);                       /* 40-bit physical */
+	g_smmu_wr("CB0 TCR", cb + 0x30, 0x80803519u);                 /* EAE, T0SZ 25, 4K, inner sh, WB */
+	g_smmu_wr("CB0 MAIR0", cb + 0x38, 0x000000ffu);
+	g_smmu_wr("CB0 MAIR1", cb + 0x3c, 0x0u);
+	g_smmu_wr("CB0 SCTLR", cb, 0x67u);                            /* M|TRE|AFE|CFRE|CFIE */
+
+	vm_offset_t atsva = g_gpu_map(cb + 0x800);
+	printf("SWEET GPUT: ATS1PR translate IOVA 0x5000 ...\n");
+	g_wait(300);
+	*(volatile uint64_t *)atsva = 0x5000ULL;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	vm_offset_t atsr = g_gpu_map(cb + 0x8f0);
+	uint32_t st = 1;
+	for (int i = 0; i < 100 && (st & 1u); i++) {
+		g_wait(1);
+		st = *(volatile uint32_t *)atsr;
+	}
+	uint64_t par = *(volatile uint64_t *)g_gpu_map(cb + 0x50);
+	printf("SWEET GPUT: ATSR 0x%08x PAR 0x%016llx FSR 0x%08x\n", st, (unsigned long long)par,
+	    *(volatile uint32_t *)g_gpu_map(cb + 0x58));
+	if (!(par & 1u) && (par & 0xfffffffff000ULL) == td) {
+		printf("SWEET GPUT: SMMU TRANSLATION OK (IOVA 0x5000 -> PA 0x%llx)\n", (unsigned long long)(par & 0xfffffffff000ULL));
+	} else {
+		printf("SWEET GPUT: translation did not give PA 0x%llx\n", (unsigned long long)td);
+	}
+	g_wait(500);
+}
+
+/*
+ * stage 12: ask TrustZone (Qualcomm SCM over SMCCC, std call, SMC64, SIP owner) which of the
+ * PIL calls the zap shader load needs exist. Read-only: QCOM_SCM_INFO_IS_CALL_AVAIL for each
+ * call, and PAS_IS_SUPPORTED for the GPU zap (pas id 13). No image is passed to TZ.
+ */
+static void
+g_smc(uint64_t a[4])
+{
+	register uint64_t x0 __asm__("x0") = a[0];
+	register uint64_t x1 __asm__("x1") = a[1];
+	register uint64_t x2 __asm__("x2") = a[2];
+	register uint64_t x3 __asm__("x3") = a[3];
+	register uint64_t x4 __asm__("x4") = 0;
+	register uint64_t x5 __asm__("x5") = 0;
+	register uint64_t x6 __asm__("x6") = 0;
+	__asm__ volatile ("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6)
+	    :
+	    : "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	a[0] = x0; a[1] = x1; a[2] = x2; a[3] = x3;
+}
+
+#define G_SCM_FN(svc, cmd) (0x40000000ull | (2ull << 24) | (((uint64_t)(svc) & 0xffu) << 8) | ((cmd) & 0xffu))
+
+static void
+g_scm_probe(void)
+{
+	static const struct { uint8_t svc, cmd; const char *name; } q[] = {
+		{ 0x02, 0x07, "PIL_PAS_IS_SUPPORTED" }, { 0x02, 0x01, "PIL_PAS_INIT_IMAGE" },
+		{ 0x02, 0x02, "PIL_PAS_MEM_SETUP" }, { 0x02, 0x05, "PIL_PAS_AUTH_AND_RESET" },
+		{ 0x02, 0x06, "PIL_PAS_SHUTDOWN" }, { 0x01, 0x01, "INFO_IS_CALL_AVAIL" },
+	};
+	for (unsigned i = 0; i < sizeof(q) / sizeof(q[0]); i++) {
+		uint64_t a[4] = { G_SCM_FN(0x01, 0x01), 1, G_SCM_FN(q[i].svc, q[i].cmd), 0 };
+		printf("SWEET GPUZ: IS_CALL_AVAIL(%s fn 0x%llx) ...\n", q[i].name, (unsigned long long)a[2]);
+		g_wait(300);
+		g_smc(a);
+		printf("SWEET GPUZ: %s -> ret 0x%llx val 0x%llx (%s)\n", q[i].name, (unsigned long long)a[0],
+		    (unsigned long long)a[1], (a[0] == 0 && a[1] != 0) ? "AVAILABLE" : "not available / error");
+		g_wait(300);
+	}
+	uint64_t b[4] = { G_SCM_FN(0x02, 0x07), 1, 13, 0 };
+	printf("SWEET GPUZ: PAS_IS_SUPPORTED(13) ...\n");
+	g_wait(300);
+	g_smc(b);
+	printf("SWEET GPUZ: PAS_IS_SUPPORTED(13) -> ret 0x%llx val 0x%llx\n", (unsigned long long)b[0], (unsigned long long)b[1]);
+	g_wait(300);
+}
+
+/*
+ * stage 13: sort out what the stage 12 answers mean. Read-only SMCs again:
+ *  - PAS_IS_SUPPORTED for every pas id 0..31 (known-good ids such as modem/adsp tell us how a
+ *    "supported" answer looks, so we can read the one for id 13 (GPU zap) correctly)
+ *  - a deliberately bogus SIP function, to see what "unknown function" looks like
+ *  - the INFO_IS_CALL_AVAIL probe in the 32-bit and 64-bit conventions, Linux's convention probe
+ */
+static void
+g_scm_probe2(void)
