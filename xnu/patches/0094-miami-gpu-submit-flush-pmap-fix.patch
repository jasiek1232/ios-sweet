diff --git a/bsd/dev/sweet_gpu_a619.c b/bsd/dev/sweet_gpu_a619.c
index ce31f13..d7aefed 100644
--- a/bsd/dev/sweet_gpu_a619.c
+++ b/bsd/dev/sweet_gpu_a619.c
@@ -45,6 +45,7 @@ int sweet_gpu_wait(uint32_t seq, unsigned timeout_ms);
 void sweet_gpu_service_selftest(void);	/* SweetGPUService.cpp: drives the IOKit user client from inside the kernel */
 
 static int g_dbg;           /* sweetgpudebug=1 */
+static int g_wrap = 1;      /* sweetgpuwrap=0: old submit tail (WAIT_FOR_IDLE + CP_MEM_WRITE), no cache events */
 static int g_sleep_chan;
 
 /* real sleep */
@@ -3390,7 +3391,14 @@ __attribute__((optnone, noinline)) int
 sweet_gpu_submit(const uint32_t *cmds, unsigned n, uint32_t *seq_out)
 {
 	volatile uint32_t *ring = (volatile uint32_t *)gp.ring.kva;
-	const unsigned total = n + 5;	/* + WAIT_FOR_IDLE (1) + CP_MEM_WRITE fence (4) */
+	/*
+	 * Like msm's a6xx_submit: CCU invalidates in front (the previous job's colour/depth cache lines must not be
+	 * read back stale), and the fence is written by CP_EVENT_WRITE CACHE_FLUSH_TS, which flushes the GPU caches
+	 * before the write, so a fence value that the CPU sees means the job's output is in memory.
+	 * Event numbers: CACHE_FLUSH_TS 0x04, PC_CCU_INVALIDATE_DEPTH 0x18, PC_CCU_INVALIDATE_COLOR 0x19.
+	 */
+	const unsigned head = g_wrap ? 4 : 0;
+	const unsigned total = head + n + 6;	/* + WAIT_FOR_IDLE (1) + fence write (5 / 4 old) */
 	unsigned tries = 0;
 
 	if (!svc.ready || n == 0 || total > G_RING_DW / 2)
@@ -3407,15 +3415,36 @@ sweet_gpu_submit(const uint32_t *cmds, unsigned n, uint32_t *seq_out)
 		g_settle(1);
 	}
 	uint32_t w = svc.wptr;
+	if (g_wrap) {
+		const uint32_t hd[4] = { G_PKT7(0x46, 1), 0x18, G_PKT7(0x46, 1), 0x19 };
+		for (unsigned i = 0; i < 4; i++)
+			ring[(w + i) & (G_RING_DW - 1)] = hd[i];
+		w += 4;
+	}
 	for (unsigned i = 0; i < n; i++)
 		ring[(w + i) & (G_RING_DW - 1)] = cmds[i];
 	w += n;
 	const uint32_t seq = ++svc.seq;
-	const uint32_t tail[5] = { G_PKT7(0x26, 0), G_PKT7(0x3d, 3), (uint32_t)gp.fence.iova,
-		(uint32_t)(gp.fence.iova >> 32), seq };
-	for (unsigned i = 0; i < 5; i++)
+	uint32_t tail[6];
+	unsigned tn;
+	tail[0] = G_PKT7(0x26, 0);
+	if (g_wrap) {
+		tail[1] = G_PKT7(0x46, 4);
+		tail[2] = 0x04;		/* CACHE_FLUSH_TS, no IRQ (the kernel has no SPI support) */
+		tail[3] = (uint32_t)gp.fence.iova;
+		tail[4] = (uint32_t)(gp.fence.iova >> 32);
+		tail[5] = seq;
+		tn = 6;
+	} else {
+		tail[1] = G_PKT7(0x3d, 3);
+		tail[2] = (uint32_t)gp.fence.iova;
+		tail[3] = (uint32_t)(gp.fence.iova >> 32);
+		tail[4] = seq;
+		tn = 5;
+	}
+	for (unsigned i = 0; i < tn; i++)
 		ring[(w + i) & (G_RING_DW - 1)] = tail[i];
-	w += 5;
+	w += tn;
 	flush_dcache64((addr64_t)gp.ring.pa, 0x8000, TRUE);
 	__asm__ volatile ("dsb sy" ::: "memory");
 	svc.wptr = w & (G_RING_DW - 1);
@@ -3966,16 +3995,18 @@ g_gpu_thread(void *arg, wait_result_t w)
 void
 sweet_gpu_a619_start(void)
 {
-	int mode = 0, dbg = 0, probe = 0;
+	int mode = 0, dbg = 0, probe = 0, wrap = 1;
 	thread_t thread;
 	PE_parse_boot_argn("sweetgpu", &mode, sizeof(mode));
 	PE_parse_boot_argn("sweetgpuprobe", &probe, sizeof(probe));
 	PE_parse_boot_argn("sweetgpudebug", &dbg, sizeof(dbg));
+	PE_parse_boot_argn("sweetgpuwrap", &wrap, sizeof(wrap));
 	if (mode == 0 && (probe == 16 || probe == 17))
 		mode = probe - 15;
 	if (mode <= 0)
 		return;
 	g_dbg = dbg;
+	g_wrap = wrap != 0;
 	if (kernel_thread_start(g_gpu_thread, (void *)(uintptr_t)mode, &thread) == KERN_SUCCESS)
 		thread_deallocate(thread);
 	else
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index bbd648e..2cebcae 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -6905,7 +6905,8 @@ void
 pmap_sync_page_attributes_phys(
 	ppnum_t pp)
 {
-	flush_dcache((vm_offset_t) (pp << PAGE_SHIFT), PAGE_SIZE, TRUE);
+	/* ppnum_t is 32 bits: shifting it unwidened drops the top bits of any PA above 4 GiB (RAM starts at 0x80000000 here) */
+	flush_dcache((vm_offset_t) ((pmap_paddr_t) pp << PAGE_SHIFT), PAGE_SIZE, TRUE);
 }
 
